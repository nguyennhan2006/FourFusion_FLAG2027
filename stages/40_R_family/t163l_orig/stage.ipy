print("[cell] 01 run parameters (kapi --env): environment variables of this r", flush=True)
# run parameters (kapi --env): environment variables of this run
import os
os.environ['RFS_MODE'] = 'L'
# FF: upload disabled, the output folder becomes a runner artifact (CHANGES.md). Original: os.environ['RFS_UPLOAD'] = 'onnhqunhh/flag2027-rfs-lora-p'
# <<<FF-CELL>>>
print("[boot] FLAG_163_rfs | python", __import__("sys").version.split()[0], "| start", __import__("time").strftime("%Y-%m-%d %H:%M:%S"), flush=True)  # heartbeat rule: first output, before any import
print("[cell] setup: files + deps", flush=True)
import os, sys, json, gzip, base64, subprocess, shutil, time
from pathlib import Path
MODE = os.environ.get("RFS_MODE", "P").upper(); SMOKE = os.environ.get("FLAG_SMOKE") == "1"
W = Path("/kaggle/working") if Path("/kaggle/working").exists() else Path("./rfs_work"); W.mkdir(exist_ok=True)
CODE = W / "rfs"
for rel, blob in (("train/assemble.py", ""), ("train/rfs_train.py", ""), ("ref/flag_final_core_092.py", ""), ("ref/manifest_final.json", "")):
    p = CODE / rel; p.parent.mkdir(parents=True, exist_ok=True); p.write_bytes(gzip.decompress(base64.b64decode(blob)))
if MODE == "B":   # FF redaction (CHANGES.md): train/gender.csv was an embedded copy of the organisers' meta_file_train_set.csv; the same bytes come from the raw-v4 input (only assemble.py, RFS_MODE=B, reads the file)
    _ff_g = [q for q in sorted(Path("/kaggle/input").rglob("meta_file_train_set.csv")) if __import__("hashlib").sha256(q.read_bytes()).hexdigest() == "fd7991a3353b9f90b2120b8d79fdf50ebaef6438c2e128be162ffbbf6d29c030"]
    assert _ff_g, "the organisers' meta_file_train_set.csv (sha256 fd7991a3...) was not found under /kaggle/input (dataset ngnnguynchn/flag2027-raw-v4-p)"
    (CODE / "train" / "gender.csv").write_bytes(_ff_g[0].read_bytes()); print("FF: train/gender.csv <-", _ff_g[0], flush=True)
TRAIN = CODE / "train" / "rfs_train.py"
def run(args, env=None):
    """chay rfs_train.py, chuyen stdout tung dong ra log"""
    p = subprocess.Popen([sys.executable, "-u", str(TRAIN), *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env={**os.environ, **(env or {})})
    for line in p.stdout: print(line, end="", flush=True)
    assert p.wait() == 0, "rfs_train.py failed"
if MODE == "L" and not SMOKE:
    for c in ("pip -q install iopath ftfy regex fvcore", "pip -q install --no-deps git+https://github.com/facebookresearch/ImageBind"):
        print(subprocess.run(c, shell=True, capture_output=True, text=True).stdout[-300:], flush=True)
import torch
print("mode", MODE, "smoke", SMOKE, "cuda", torch.cuda.is_available(), "gpus", torch.cuda.device_count(), flush=True)
# <<<FF-CELL>>>
print("[cell] inputs: bundle, lid, roots", flush=True)
IN = Path("/kaggle/input")
def find_all(name):
    return sorted(p for p in IN.rglob(name)) if IN.exists() else []
if MODE in ("B", "L") and not find_all("train_English.txt"):   # FF path (CHANGES.md): FF_DATA keeps the organisers' train_set.zip packed (Kaggle served the dataset extracted); unpack train_set.zip only, next to itself; dev_set.zip is never opened
    import zipfile as _ff_zf
    _ff_tz = find_all("train_set.zip")
    assert len(_ff_tz) == 1, f"raw-v4: neither train_English.txt nor exactly one train_set.zip under {IN}: {_ff_tz}"
    with _ff_zf.ZipFile(_ff_tz[0]) as _ff_z:
        _ff_z.extractall(_ff_tz[0].parent)
    print("FF: unpacked", _ff_tz[0], "->", _ff_tz[0].parent / "train_set", "(dev_set.zip left packed)", flush=True)
WORK = W / "work"; WORK.mkdir(exist_ok=True); ART = W / "rfs_art"; BUNDLE = None; LID = ""
if MODE == "B":      # ghep FLAG_162 (a, b, c) + FLAG_160 (whv3 a, b, c) thanh bundle (CPU, vai phut)
    def dsdir(slug_part):
        r = [p for p in IN.rglob("*") if p.is_dir() and p.name.startswith("flag2027-feats-") and slug_part in p.name]
        assert r, f"thieu dataset *{slug_part}*"; return r[0]
    Q = lambda n: str(find_all(n)[0].parent)
    BUNDLE = W / "rfs_bundle"
    cmd = [str(CODE / "train" / "assemble.py")]
    p = subprocess.Popen([sys.executable, "-u", *cmd, "--out", str(BUNDLE), "--rfs_a", str(dsdir("rfs-a")), "--rfs_b", str(dsdir("rfs-b")), "--rfs_c", str(dsdir("rfs-c")),
                          "--wh_a", str(dsdir("whv3-a")), "--wh_b", str(dsdir("whv3-b")), "--wh_c", str(dsdir("whv3-c")), "--extmeta", Q("ext_v1_complete_face_meta.csv"),
                          "--rawv4", Q("train_English.txt"), "--gender_csv", str(CODE / "train" / "gender.csv")], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout: print(line, end="", flush=True)
    assert p.wait() == 0, "assemble failed"
elif SMOKE:
    BUNDLE = W / "bundle_synth"; run(["synth", "--bundle", str(BUNDLE)]); LID = str(BUNDLE / "lid_strict.json")
    torch.save({"params": [torch.zeros(2)]}, WORK / "lora_C1.pt")          # smoke: lora gia (luot L that chay tren Kaggle GPU)
elif True:
    cand = [p.parent for p in find_all("ext.npz") if (p.parent / "v4.npz").exists()]
    assert cand, "thieu bundle (ext.npz + v4.npz): gan dataset dac trung RFS-01 (FLAG_162 + adapter, README 'Hop dong bundle')"
    BUNDLE = cand[0]; l = find_all("lid_strict.json"); assert l, "thieu lid_strict.json (ngnnguynchn/flag2027-lid-strict-p)"; LID = str(l[0])
    if MODE == "P":
        for n in ("lora_C1.pt", "v4_extra.npz"):
            f = find_all(n); assert f, f"thieu {n}: gan dataset dau ra cua luot L"; shutil.copy(f[0], WORK / n)
print("bundle", BUNDLE, "| lid", LID, flush=True)
# <<<FF-CELL>>>
print("[cell] lora C1 (ImageBind-audio) + v4 lora/tuoi", flush=True)
if MODE == "L":
    import torch as _t
    ck = W / "imagebind_huge.pth"
    if not ck.exists():
        _t.hub.download_url_to_file("https://huggingface.co/PKU-Alignment/AnyRewardModel/resolve/40c7e2ade237848a194b2b77517da024c4ec8532/imagebind/imagebind_huge.pth", str(ck) + ".part", progress=False); os.replace(str(ck) + ".part", ck)
    _ff_h = __import__("hashlib").sha256()   # FF url (CHANGES.md): the pinned mirror must serve Meta's imagebind_huge.pth byte for byte
    with open(ck, "rb") as _ff_f:
        for _ff_b in iter(lambda: _ff_f.read(1 << 24), b""): _ff_h.update(_ff_b)
    assert _ff_h.hexdigest() == "d6f6c22bedcc90708448d5d2fbb7b2db9c73f505dc89bd0b2e09b23af1b62157", f"imagebind_huge.pth sha256 {_ff_h.hexdigest()} != d6f6c22b... (ImageBind-huge of Meta)"
    tars = [p for p in find_all("tar0000.npz") if p.parent.name == "vox"]; assert tars, "thieu audio cache (duongphihoang/flag2027-audio-cache-p)"
    mav = None
    for d, dirs, files in os.walk(IN):
        dirs.sort()   # FF determinism (CHANGES.md): visit folders in name order so mavceleb_v1_complete-001/v1 is found before mavceleb_v2_complete-002/v2, as in the original run (210 clips of the 70 MAV-Celeb v1 persons)
        if Path(d).name in ("v1", "v2") and {"faces", "voices"} <= set(dirs): mav = Path(d).parent; break
        dirs[:] = [x for x in dirs if x not in ("faces", "voices")] if len(Path(d).relative_to(IN).parts) < 7 else []
    assert mav, "thieu MAV raw (chnnhnnguyn/external-data-mavceleb)"
    v4 = None
    for d, dirs, files in os.walk(IN):
        if "train_English.txt" in files and Path(d, "faces").is_dir(): v4 = Path(d); break
        dirs[:] = [x for x in dirs if x not in ("faces", "voices")] if len(Path(d).relative_to(IN).parts) < 7 else []
    assert v4, "thieu raw-v4 (ngnnguynchn/flag2027-raw-v4-p)"
    if not SMOKE:   # FF variant guard (CHANGES.md): dry run of lora_data before training, no weights touched
        print("[cell] FF dry check: LoRA C1 clip list (expected 210 clips, 70 persons, all MAV-Celeb v1, 0 VoxCeleb2)", flush=True)
        _ff_src = '''import collections, json, sys, types, importlib.util
train, bundle, lid, cache, mav, out = sys.argv[1:7]
spec = importlib.util.spec_from_file_location("rfs_train_ff_drycheck", train)
R = importlib.util.module_from_spec(spec); spec.loader.exec_module(R)
E, _ = R.load_bundle(bundle)
a = types.SimpleNamespace(lid=lid, cache=cache, mav=mav)
wavs, pid, names = R.lora_data(E, R.read_lid(a), a, cap=None)
key = lambda k: k[0] + ":" + (k[1].split("_")[0] if k[0] == "mav" else "-")
inv = {j: k for k, j in names.items()}
got = {"clips": len(wavs), "persons": len(names), "clips_by_source": dict(collections.Counter(key(inv[int(j)]) for j in pid)),
       "persons_by_source": dict(collections.Counter(key(k) for k in names))}
exp = {"clips": 210, "persons": 70, "clips_by_source": {"mav:v1": 210}, "persons_by_source": {"mav:v1": 70}}
ok = got == exp
json.dump({"ok": ok, "mav_root": mav, "expected": exp, "got": got}, open(out, "w"), indent=1)
print("FF lora dry check:", "OK" if ok else "MISMATCH", json.dumps(got), flush=True)
sys.exit(0 if ok else 3)
'''
        _ff_dry = WORK / "ff_lora_drycheck.py"; _ff_dry.write_text(_ff_src, encoding="utf-8")
        _ff_p = subprocess.Popen([sys.executable, "-u", str(_ff_dry), str(TRAIN), str(BUNDLE), LID, str(tars[0].parent.parent), str(mav), str(W / "ff_lora_drycheck.json")], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for _ff_l in _ff_p.stdout: print(_ff_l, end="", flush=True)
        assert _ff_p.wait() == 0, "FF dry check failed: the LoRA C1 data selection differs from the original run (expected 210 clips / 70 persons, all MAV-Celeb v1); see ff_lora_drycheck.json"
    run(["lora", "--bundle", str(BUNDLE), "--work", str(WORK), "--lid", LID, "--ib_ckpt", str(ck), "--cache", str(tars[0].parent.parent), "--mav", str(mav), "--v4root", str(v4)])
    OUTD = W / "rfs_lora"; OUTD.mkdir(exist_ok=True)
    for n in ("lora_C1.pt", "v4_extra.npz"): shutil.copy(WORK / n, OUTD / n)
    _ff_m = torch.load(OUTD / "lora_C1.pt", map_location="cpu")   # FF variant guard (CHANGES.md): training metadata of this C1 for the post_check (original file: 48 params, 1200 steps, batch 64, 210 clips, 70 persons, 0 skipped)
    (W / "ff_lora_meta.json").write_text(json.dumps({"n_params": len(_ff_m["params"]), **{k: _ff_m[k] for k in ("steps", "batch", "clips", "persons", "skipped")}}, indent=1))
else:
    print("mode P: lora tu dataset cua luot L", flush=True)
# <<<FF-CELL>>>
print("[cell] split + oof + proj + fuse + release + selfcheck", flush=True)
if MODE == "P":
    t0 = time.time()
    run(["all", "--bundle", str(BUNDLE), "--work", str(WORK), "--art", str(ART), "--lid", LID, "--lora", str(WORK / "lora_C1.pt")])
    print(f"P done [{time.time() - t0:.0f}s]; artifact:", sorted(p.name for p in ART.iterdir()), flush=True)
    print((ART / "fuse_report.json").read_text(), flush=True)
# <<<FF-CELL>>>
print("[cell] upload", flush=True)
UPL = os.environ.get("RFS_UPLOAD", "")
OUT = {"L": W / "rfs_lora", "B": W / "rfs_bundle"}.get(MODE, ART)
if SMOKE:
    print("smoke: no upload; artifact", sorted(p.name for p in OUT.iterdir()) if OUT.exists() else None, flush=True)
elif UPL:
    try:
        import kagglehub
        kagglehub.dataset_upload(UPL, str(OUT), version_notes=f"RFS-01 FLAG_163 mode {MODE}")
        print("uploaded ->", UPL, flush=True)
    except Exception as e:
        print(f"upload to {UPL} failed ({e!r}); files are in the notebook output", flush=True)
print("ALL CELLS OK", flush=True)
# <<<FF-CELL>>>
