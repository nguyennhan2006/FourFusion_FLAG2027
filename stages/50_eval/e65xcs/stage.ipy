            or (n != "facelora_ckpt.pt" and re.search(r"feats[-_]ls[-_]c5s[-_]p", p.as_posix()))]   # B3-EVAL: saved adapter
    if prev and not (OUT / n).exists():
        shutil.copy(prev[0], OUT / n); log("resume:", n)
