# ============================================================================ the adapted encoder in the FLAG_12 encoder interface (MAV-Celeb rows)
class Adapted:
    kind = "face"

    def __init__(self):
        VIS.eval()

    def prep(self, im):
        return PRE(im)

    @torch.no_grad()
    def __call__(self, x, use_amp=True):
        with torch.autocast("cuda", enabled=use_amp and DEV.type == "cuda"):
            return {"": ENC_FWD(x.to(DEV)).float().cpu().numpy()}


