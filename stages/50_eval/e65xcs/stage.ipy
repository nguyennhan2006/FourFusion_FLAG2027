print("[cell] 12 B3-EVAL: re-extracted arrays vs the saved ones (no VoxCeleb2", flush=True)
# ============================================================================ B3-EVAL: re-extracted arrays vs the saved ones (no VoxCeleb2 / VoxBlink rows)
ref_dir = next((p.parent for p in FILES.get("face_clipC5_train.npy", []) if OUT.name not in p.as_posix()), None)
assert ref_dir is not None, "attach quynhnhu82/flag2027-feats-ls-c5s-p"
chk = {}
for f in sorted(OUT.glob("face_clipC5_*.npy")) + sorted(OUT.glob("ext_*_face_clipC5.npy")):
    r = ref_dir / f.name
    if ONLY_UNDER and not (f.name.startswith("ext_") or f.name.endswith("_train.npy")):   # Evaluation lists (11/11)
        chk[f.name] = "Evaluation list: no saved reference"; continue
    if not r.exists():
        chk[f.name] = "no reference (new list)"; continue
    a, b = np.load(f).astype(np.float32), np.load(r).astype(np.float32)
    n = min(len(a), len(b)) if SMOKE else len(b)
    assert len(a) == n or SMOKE, (f.name, a.shape, b.shape)
    a, b = a[:n], b[:n]
    ok = np.isfinite(a).all(1) & np.isfinite(b).all(1)
    cos = (l2n_(a[ok]) * l2n_(b[ok])).sum(1)
    chk[f.name] = dict(rows=int(n), finite=int(ok.sum()), mean_cos=round(float(cos.mean()), 6), min_cos=round(float(cos.min()), 6))
log("B3-EVAL re-extracted vs saved:", json.dumps(chk, indent=1))
bad = {k: v for k, v in chk.items() if isinstance(v, dict) and v["min_cos"] < 0.999}
assert not bad, f"the saved adapter does not reproduce the saved arrays: {bad}"
log("OK: attach this output (feats_clipb3_x/) to FLAG_82b; on Evaluation set E2E_SPLIT=eval there")
# <<<FF-CELL>>>
print("[cell] 13 man = created: time.strftime(Y-m-d H:M), splits: k: len(vwav", flush=True)
man = {"created": time.strftime("%Y-%m-%d %H:%M"), "splits": {k: len(v["wav"]) for k, v in S.items()},
       "external": {k: [len(r.face), len(r.voice)] for k, r in EXT.items()}, "encoders": ENCODERS,
       "checks": CHECKS, "failed": FAILED, "audio": AUDIO_STATS, "broken": BROKEN, "resumed_arrays": len(SEEDED),
       "versions": {"torch": torch.__version__, "transformers": transformers.__version__},
       "files": {f.name: list(np.load(f, mmap_mode="r").shape) for f in sorted(OUT.glob("*.npy"))}}
try:
    import speechbrain, insightface
    man["versions"].update(speechbrain=speechbrain.__version__, insightface=insightface.__version__)
except Exception:
    pass
man["reshape"] = RESHAPE                 # flattened wide arrays: row -> (L, D)
(OUT / "feats_manifest.json").write_text(json.dumps(man, indent=1))
shutil.rmtree(WORKDIR / "raw", ignore_errors=True)
tot = sum(p.stat().st_size for p in OUT.glob("*")) / 1e9
print(f"{len(man['files'])} arrays, {tot:.2f} GB in {OUT} | failed: {FAILED or 'none'}")
print("NEXT: Save Version (Save & Run All) -> Output -> New Dataset -> name it flag2027-feats-clipc5c-test-p (re-run with this output attached until every encoder is done)")
# <<<FF-CELL>>>
