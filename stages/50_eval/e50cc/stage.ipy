# ============================================================================ BEST/v6_eval/pipeline.py (verbatim)
SRC_BEST_V6_EVAL_PIPELINE_PY = r'''"""Evaluation-phase pipeline v6 (docs/PLAN_EVAL.md, E1): SET-13, its no-cluster version and INDEP-01 from ONE set of
trained members, chosen per test file.

    python pipeline.py --data <organiser data> --feats <dir> [<dir> ...] --out <dir>
                       [--mode auto|set13|noclus|indep] [--file-mode <file>=<mode> ...] [--n-models 15]
                       [--members-from <dir>] [--reference name=zip ...]

  set13  SET-13, CodaBench 21.01 on dev (BEST/v5_set13): per-file centring and z-scores, ImageBind + age on the s007
         member, clusters (ArcFace faces, ECAPA-192 voices, thresholds calibrated on train speakers), block mean b = 0.99,
         rank fusion per cell.
  noclus SET-13 without the clusters (b = 0; = v5 --b 0): file-centred and z-scored, every trial scored from its own cell
         of the matrix. The fallback when the clusters of a file are wrong (STRESS-01: >= INDEP-01 in almost every
         scenario, also small files and files dominated by one person).
  indep  INDEP-01, CodaBench 26.70 on dev (Experiment/INDEP-01): every pair scored on its own; every constant comes from
         20 000 random train pairs; no statistic of the test file and no clusters. A pair's score does not change when
         the rest of the file changes (checked by a self-test on every run, invariance.json). For a ruling that forbids
         using other test samples.
  auto   set13 for every file. STRESS-01 part A (200 simulated files, true labels): clustering beat pair-only scoring in
         every scenario (1 to 32 samples per person, 5 to 30 persons, one dominant person); the files it lost were tiny
         (30-120 trials) and no diagnostic predicted them. A file whose voices look over-merged (far fewer voice clusters
         than face clusters, the SET-04 failure) is FLAGGED in decisions.csv, not switched: switch it by hand with
         --file-mode <file>=noclus after reading the diagnostics (STRESS-01 part B will say whether to automate it).

Members (s007 / s010B / r2mix, EXP-007 recipe, all 70 train speakers) are trained ONCE and serve both modes. Each
(member, seed) is cached in <out>/members/ (or --members-from): seeds 1, 101, 201, ...; the first 5 are exactly the
submitted members, so --n-models 5 reproduces SET-13 / INDEP-01 and --n-models 15 (log 69: same expectation, no seed
lottery) reuses them.

--feats: every folder holding arrays by name (flag2027-feats-eval from kaggle/FLAG_12_features, or feats_v2 +
feats_models): face_arcface_*, voice_ecapa192_*, voice_ecapa6144_*, face_ibv_*, voice_iba_*, face_vitageprob_*,
voice_w2v2agage_*, for train and for every test file.

Outputs in --out: submission.zip (the chosen mode per file), submission_set13.zip, submission_noclus.zip,
submission_indep.zip, decisions.csv (per file: cluster diagnostics, mode used, warning), invariance.json, config.json.
"""
import argparse, json, os, sys, time, zipfile
from pathlib import Path
import numpy as np
import pandas as pd
from scipy.stats import rankdata
from sklearn.cluster import AgglomerativeClustering
from sklearn.metrics import adjusted_rand_score

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parents[1] / "kaggle"))

CONFIG = {
    "recipe": dict(head="mlp", drop=0.3, emb=128, epochs=40),              # EXP-007
    "members": {"s007": dict(),                                             # VGG + organiser ECAPA-192
                "s010B": dict(voice="ecapa6144"),                           # VGG + speechbrain ECAPA 6144
                "r2mix": dict(voice="ecapa192", voice_view="mix")},         # VGG + ECAPA-192, Bangla-length crops
    "seeds": "1 + 100 i",
    "cca_w": 0.25,
    "cells": {"English": ["s007", "s010B"], "Bangla": ["r2mix", "s007"]},
    "cluster_face": "arcface", "cluster_voice": "ecapa192", "b": 0.99,
    "s007_recipe": dict(w_ib=0.5, w_age=0.1),                               # SET-13 = INDEP-01 weights
    "ref_pairs": 20000,                                                     # INDEP: constants from random train pairs
    # auto = set13 everywhere (STRESS-01 A). Dropped after STRESS-01 A, both cost EER: "largest cluster > 25 % of the
    # file -> indep" (2.6 to 5.7 lost on files dominated by one person) and "median cluster size < 2 -> indep"
    # (2 to 6 lost at one sample per person). Kept as a WARNING only:
    "auto": dict(warn_voice_face_ratio=0.8),  # far fewer voice clusters than face clusters: voices of people merged?
}
AGE_MIDS = np.array([1, 6, 15, 25, 35, 45, 55, 65, 75], dtype=np.float32)   # centres of the 9 FairFace age bins
zm = lambda M: (M - M.mean()) / (M.std() + 1e-9)
rank = lambda s: rankdata(s) / (len(s) + 1)
pair = lambda U, W: np.sum(U * W, 1)


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


# ============================================================================ clusters (as SET-02)
def cent(Z, l2n):
    return l2n(l2n(Z) - l2n(Z).mean(0))


def clus(Z, t):
    return AgglomerativeClustering(None, metric="cosine", linkage="average", distance_threshold=t).fit_predict(Z)


def block(M, cf, cv, b):
    M = M.astype(np.float64)
    Af = np.zeros((cf.max() + 1, len(cf))); Af[cf, np.arange(len(cf))] = 1; Af /= Af.sum(1, keepdims=True)
    Av = np.zeros((cv.max() + 1, len(cv))); Av[cv, np.arange(len(cv))] = 1; Av /= Av.sum(1, keepdims=True)
    return (1 - b) * np.diag(M) + b * (Af @ M @ Av.T)[cf, cv]


def diagnose(cf, cv):
    """Cluster diagnostics of one test file, no labels. Sizes are per SAMPLE (the size of the cluster it sits in)."""
    sf, sv = np.bincount(cf), np.bincount(cv)
    return dict(rows=len(cf), face_clusters=len(sf), voice_clusters=len(sv),
                voice_face_ratio=round(len(sv) / len(sf), 3),
                face_median_size=float(np.median(sf[cf])), voice_median_size=float(np.median(sv[cv])),
                face_singletons=int((sf == 1).sum()), voice_singletons=int((sv == 1).sum()),
                largest_share=round(float(max(sf.max(), sv.max()) / len(cf)), 3))


def decide(d):
    """-> (mode, note). Always set13 (STRESS-01 A); over-merged-looking voices are flagged for a manual decision."""
    r = CONFIG["auto"]
    if d["voice_face_ratio"] < r["warn_voice_face_ratio"]:
        return "set13", (f"WARNING voice/face clusters {d['voice_face_ratio']} < {r['warn_voice_face_ratio']}: voices of "
                         f"different people may be merged; check, and if so rerun with --file-mode <file>=noclus")
    return "set13", "clusters look normal"


# ============================================================================ members
def train_members(V, store, n, cache: Path):
    """{member: (cfg, [(net, prep), ...])}; each (member, seed) is trained once and cached as <member>_seed<s>.pt."""
    import torch
    cache.mkdir(parents=True, exist_ok=True)
    out = {}
    for name, extra in CONFIG["members"].items():
        cfg = dict(V.BASE, **CONFIG["recipe"], **extra)
        nets = []
        for i in range(n):
            seed = 1 + 100 * i                                              # = flag_v2.dev_scores(seed0=1)
            f = cache / f"{name}_seed{seed}.pt"
            if f.exists():
                nets.append(torch.load(f, weights_only=False))
            else:
                t = time.time()
                nets.append(V.train_one(store, cfg, np.arange(len(store.spk)), seed=seed))
                torch.save(nets[-1], f)
                log(f"trained {name} seed {seed} in {time.time() - t:.0f}s")
        out[name] = (cfg, nets)
    log("members:", {k: len(v[1]) for k, v in out.items()})
    return out


class Std:
    """z-score with constants measured on the train reference pairs only."""
    def __init__(self, ref):
        self.m, self.s = float(np.mean(ref)), float(np.std(ref) + 1e-9)

    def __call__(self, x):
        return (x - self.m) / self.s


class Scorer:
    """Both scorings of one member. l1_matrix: SET-13's full face x voice matrix of a test file (file-centred, z over the
    matrix; = flag_v2.dev_scores(matrix_path=...)). pairs: INDEP-01's score of row-aligned (face, voice) pairs."""

    def __init__(self, V, store, cfg, nets, ref):
        from flag_lib import RidgeCCA
        self.V, self.store, self.cfg, self.nets = V, store, cfg, nets
        self.Xf, self.Xv = store.face(cfg["face"], "train"), store.voice(cfg["voice"], "train")
        self.cca = RidgeCCA(**V.CCA_CFG).fit(self.Xf, self.Xv)
        self.stds, parts = [], []
        for net, prep in nets:
            r = pair(*[e[i] for e, i in zip(self.embed0(net, prep, self.Xf, self.Xv), ref)])
            self.stds.append(Std(r)); parts.append(self.stds[-1](r))
        cref = pair(self.cca.transform_x(self.Xf)[ref[0]], self.cca.transform_y(self.Xv)[ref[1]])
        self.cstd = Std(cref)
        w = CONFIG["cca_w"]
        self.ref = (1 - w) * np.mean(parts, 0) + w * self.cstd(cref)       # this member's score on the reference pairs

    def embed0(self, net, prep, F_, V_):
        """The member's embeddings with NO test-set centring (train standardisation / PCA only)."""
        import torch
        with torch.no_grad():
            u, w = net(torch.tensor(prep.f(F_), device=self.V.DEVICE), torch.tensor(prep.v(V_), device=self.V.DEVICE))
        return u.cpu().numpy(), w.cpu().numpy()

    def rows(self, split):
        return self.store.face(self.cfg["face"], split), self.store.voice(self.cfg["voice"], split)

    def pairs(self, Af, Av):
        w = CONFIG["cca_w"]
        deep = np.mean([sd(pair(*self.embed0(net, prep, Af, Av))) for (net, prep), sd in zip(self.nets, self.stds)], 0)
        return (1 - w) * deep + w * self.cstd(pair(self.cca.transform_x(Af), self.cca.transform_y(Av)))

    def l1_matrix(self, split):
        V = self.V
        Af, Av = self.rows(split)
        embs = [V.embed(net, prep, Af, Av, prep.f(self.Xf).mean(0), prep.v(self.Xv).mean(0)) for net, prep in self.nets]
        M = np.mean([zm(Ef @ Ev.T) for Ef, Ev in embs], 0)
        cx, cy = V.cca_proj(self.Xf, self.Xv, Af, Av)
        M = (1 - CONFIG["cca_w"]) * M + CONFIG["cca_w"] * zm(cx @ cy.T)
        return M.astype(np.float16).astype(np.float64)                     # dev_scores stored fp16: kept for identity


# ============================================================================ main
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--data", required=True, help="organiser data (train/ + test files: faces/voices csv + lists)")
    ap.add_argument("--feats", required=True, nargs="+", help="folders with the named arrays (FLAG_12 output, ...)")
    ap.add_argument("--out", required=True)
    ap.add_argument("--mode", default="auto", choices=["auto", "set13", "noclus", "indep"])
    ap.add_argument("--file-mode", nargs="*", default=[], help="per-file override, e.g. gender/Bangla=noclus")
    ap.add_argument("--n-models", type=int, default=15)
    ap.add_argument("--members-from", help="folder with cached <member>_seed<s>.pt (default: <out>/members)")
    ap.add_argument("--reference", nargs="*", default=[], help="name=zip: rank correlation of our zip 'name' with it")
    ap.add_argument("--threads", type=int, default=10)
    ap.add_argument("--ib-all", nargs="*", default=None, metavar="LANG",
                    help="apply the ImageBind + age recipe to EVERY member of a cell, not only s007 (FUSE-05). "
                         "No value = every cell (SET-16, CB 20.79); 'English' = English cells only (SET-16E, CB 19.29)")
    ap.add_argument("--dump", help="npz: level-0 component scores + the s007 recipe inputs of every dev file (SAFE-02 dev bundle)")
    ap.add_argument("--aclip", type=float, default=0.0,
                    help="weight of z(AudioCLIP face-voice cosine) added where --ib-all applies (FUSE-07; needs FLAG_14 arrays)")
    a = ap.parse_args()
    import torch
    torch.set_num_threads(a.threads)
    os.environ["FLAG_FEATS_EXTRA"] = os.pathsep.join(a.feats[1:])
    import flag_v2 as V
    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
    (out / "config.json").write_text(json.dumps(dict(CONFIG, mode=a.mode, n_models=a.n_models, feats=a.feats, ib_all=a.ib_all), indent=1))
    store = V.FeatureStore(a.data, feats_dir=a.feats[0])
    V.polarity_preflight()
    FILES = list(V.CELLS)                                                    # [(protocol, language)]

    def arr(name, split):
        f = store._find(f"{name}_{split.replace('/', '_')}.npy")
        assert f is not None, f"{name}_{split} not found in {a.feats}"
        return np.load(f).astype(np.float32)

    # 1. members, trained once for both modes
    M = train_members(V, store, a.n_models, Path(a.members_from) if a.members_from else out / "members")
    rng = np.random.RandomState(0)
    REF = (rng.randint(len(store.spk), size=CONFIG["ref_pairs"]), rng.randint(len(store.spk), size=CONFIG["ref_pairs"]))
    SC = {m: Scorer(V, store, cfg, nets, REF) for m, (cfg, nets) in M.items()}

    # ImageBind + age: level 1 uses the file's own means, level 0 the train means
    Fi_tr, Ai_tr = arr("face_ibv", "train"), arr("voice_iba", "train")
    mf, mv = Fi_tr.mean(0), Ai_tr.mean(0)
    age_f = lambda split: arr("face_vitageprob", split) @ AGE_MIDS
    age_v = lambda split: arr("voice_w2v2agage", split)[:, 0] * 100
    ib0 = lambda F_, A_: pair(V.l2n(F_ - mf), V.l2n(A_ - mv))
    R = CONFIG["s007_recipe"]
    ib_ref = ib0(Fi_tr[REF[0]], Ai_tr[REF[1]])
    age_ref = -np.abs(age_f("train")[REF[0]] - age_v("train")[REF[1]])
    z7, zib, zag = Std(SC["s007"].ref), Std(ib_ref), Std(age_ref)
    mix_ref = (1 - R["w_ib"]) * z7(SC["s007"].ref) + R["w_ib"] * zib(ib_ref); zmix = Std(mix_ref)
    z7b = Std(zmix(mix_ref) + R["w_age"] * zag(age_ref))
    zo = {m: Std(SC[m].ref) for m in SC}
    if a.aclip:                                                  # AudioCLIP at level 0: train means, train constants
        Fa_tr, Aa_tr = arr("face_aclip", "train"), arr("voice_aclip", "train")
        maf, mav = Fa_tr.mean(0), Aa_tr.mean(0)
        acl0 = lambda F_, A_: pair(V.l2n(F_ - maf), V.l2n(A_ - mav))
        acl_ref = acl0(Fa_tr[REF[0]], Aa_tr[REF[1]]); zacl = Std(acl_ref)
    RC, COMP = {}, {}

    def recipe0(m, with_acl):
        """Level-0 constants of member m's recipe, all from the train reference pairs. For s007 without AudioCLIP these
        are exactly z7 / zmix / z7b (INDEP-01)."""
        if (m, with_acl) not in RC:
            zm_ = Std(SC[m].ref)
            mix = (1 - R["w_ib"]) * zm_(SC[m].ref) + R["w_ib"] * zib(ib_ref); zmix_ = Std(mix)
            fin = zmix_(mix) + R["w_age"] * zag(age_ref)
            if with_acl:
                fin = fin + a.aclip * zacl(acl_ref)
            RC[(m, with_acl)] = (zm_, zmix_, Std(fin))
        return RC[(m, with_acl)]

    def indep(split, rows=None):
        """Level-0 score of every trial of `split` (or of the trials `rows` only), higher = same: INDEP-01, and with
        --ib-all / --aclip the level-0 version of SET-16E / SET-17 (same recipe, train constants instead of file z)."""
        take = (lambda X: X) if rows is None else (lambda X: X[rows])
        lang = split.split("/")[1]
        ib_all_here = a.ib_all is not None and (not a.ib_all or lang in a.ib_all)
        on = CONFIG["cells"][lang] if ib_all_here else ["s007"]
        with_acl = bool(a.aclip) and ib_all_here
        ib = ib0(take(arr("face_ibv", split)), take(arr("voice_iba", split)))
        age = -np.abs(take(age_f(split)) - take(age_v(split)))
        acl = acl0(take(arr("face_aclip", split)), take(arr("voice_aclip", split))) if with_acl else None
        comp = {}
        for m in CONFIG["cells"][lang]:
            s = SC[m].pairs(*map(take, SC[m].rows(split)))
            if m in on:
                zm_, zmix_, zfin = recipe0(m, with_acl)
                x = zmix_((1 - R["w_ib"]) * zm_(s) + R["w_ib"] * zib(ib)) + R["w_age"] * zag(age)
                if with_acl:
                    x = x + a.aclip * zacl(acl)
                s = zfin(x)
            else:
                s = zo[m](s)
            comp[m] = s
        if rows is None:
            COMP[split] = comp
        return np.mean([comp[m] for m in CONFIG["cells"][lang]], 0)

    # 2. clusters (thresholds from train speakers only) + diagnostics
    thr = {}
    sub = np.arange(len(store.spk))[::3]
    for kind, name, get in [("face", CONFIG["cluster_face"], store.face), ("voice", CONFIG["cluster_voice"], store.voice)]:
        Z = cent(get(name, "train"), V.l2n)
        thr[kind] = float(max(np.arange(.4, 1.21, .05), key=lambda t: adjusted_rand_score(store.spk[sub], clus(Z[sub], t))))
    log(f"cluster thresholds (train-calibrated): face {thr['face']:.2f} voice {thr['voice']:.2f}")

    # 3. both scorings, the decision per file
    S13, S1, S0, CHOSEN, rows = {}, {}, {}, {}, []
    override = dict(s.split("=", 1) for s in a.file_mode)
    assert set(override.values()) <= {"set13", "noclus", "indep"}, override
    for k in FILES:
        c = "/".join(k)
        cf = clus(cent(store.face(CONFIG["cluster_face"], c), V.l2n), thr["face"])
        cv = clus(cent(store.voice(CONFIG["cluster_voice"], c), V.l2n), thr["voice"])
        mats = {m: SC[m].l1_matrix(c) for m in CONFIG["cells"][k[1]]}
        F_, A_ = arr("face_ibv", c), arr("voice_iba", c)
        ib = V.l2n(F_ - F_.mean(0)) @ V.l2n(A_ - A_.mean(0)).T
        age = -np.abs(age_f(c)[:, None] - age_v(c)[None, :])
        ib_all_here = a.ib_all is not None and (not a.ib_all or k[1] in a.ib_all)
        recipe_on = list(mats) if ib_all_here else ["s007"]    # SET-13: s007 only; --ib-all: every member (SET-16 / 16E)
        for m in recipe_on:
            mats[m] = zm((1 - R["w_ib"]) * zm(mats[m]) + R["w_ib"] * zm(ib.astype(np.float64))) \
                + R["w_age"] * zm(age.astype(np.float64))
        if a.aclip and ib_all_here:                              # SET-17 candidate (FUSE-07): + w z(AudioCLIP) on the same members
            Fa_, Aa_ = arr("face_aclip", c), arr("voice_aclip", c)
            acl = V.l2n(Fa_ - Fa_.mean(0)) @ V.l2n(Aa_ - Aa_.mean(0)).T
            for m in recipe_on:
                mats[m] = mats[m] + a.aclip * zm(acl.astype(np.float64))
        S13[k] = np.mean([rank(block(mats[m], cf, cv, CONFIG["b"])) for m in CONFIG["cells"][k[1]]], 0)
        S1[k] = np.mean([rank(np.diag(mats[m])) for m in CONFIG["cells"][k[1]]], 0)
        S0[k] = indep(c)
        d = diagnose(cf, cv)
        mode, why = decide(d) if a.mode == "auto" else (a.mode, "forced by --mode")
        if c in override:
            mode, why = override[c], f"--file-mode (auto said: {why})"
        CHOSEN[k] = {"set13": S13, "noclus": S1, "indep": S0}[mode][k]
        rows.append(dict(file=c, mode=mode, why=why, **d))
        log(f"{c:18s} {mode:6s} | {d['face_clusters']} face / {d['voice_clusters']} voice clusters for {d['rows']} rows"
            f" | median size {d['face_median_size']:.0f} / {d['voice_median_size']:.0f} | {why}")
    D = pd.DataFrame(rows); D.to_csv(out / "decisions.csv", index=False)

    # 4. self-test: an INDEP score must not depend on the other trials (score a random half of one file again)
    k = FILES[0]; c = "/".join(k)
    half = np.sort(np.random.RandomState(1).choice(len(S0[k]), len(S0[k]) // 2, replace=False))
    diff = float(np.abs(indep(c, half) - S0[k][half]).max())
    inv = dict(file=c, rows=len(half), max_abs_diff=diff, passed=diff < 1e-4)
    (out / "invariance.json").write_text(json.dumps(inv, indent=1))
    log(f"invariance self-test on {c}: max |diff| {diff:.2e} -> {'PASSED' if inv['passed'] else 'FAILED'}")
    assert inv["passed"], "an INDEP score changed when half of the file was removed"

    if a.dump:                                                   # SAFE-02: everything a notebook needs to swap the s007 member
        D_ = {}
        for k in FILES:
            c = "/".join(k); key = c.replace("/", "_")
            for m, s in COMP[c].items():
                D_[f"{key}__comp_{m}"] = s.astype(np.float64)
            D_[f"{key}__final"] = S0[k].astype(np.float64)
            D_[f"{key}__pair_id"] = np.asarray([str(x) for x in store.dev[k][2].pair_id], dtype="U")
            Af, Av = SC["s007"].rows(c)
            D_[f"{key}__vgg"], D_[f"{key}__btc"] = Af, Av
            D_[f"{key}__ibf"], D_[f"{key}__iba"] = arr("face_ibv", c), arr("voice_iba", c)
            D_[f"{key}__agef"], D_[f"{key}__agev"] = age_f(c), age_v(c)
            if a.aclip:
                D_[f"{key}__aclf"], D_[f"{key}__aclv"] = arr("face_aclip", c), arr("voice_aclip", c)
        D_["train__vgg"], D_["train__btc"] = SC["s007"].Xf, SC["s007"].Xv
        if a.aclip:
            D_["train__aclf"], D_["train__aclv"] = Fa_tr, Aa_tr
        np.savez_compressed(a.dump, **D_)
        log("dump ->", a.dump, len(D_), "arrays")

    # 5. zips
    zips = {"set13": out / "submission_set13.zip", "noclus": out / "submission_noclus.zip",
            "indep": out / "submission_indep.zip", "chosen": out / "submission.zip"}
    for name, sc in [("set13", S13), ("noclus", S1), ("indep", S0), ("chosen", CHOSEN)]:
        V.write_zip(store, zips[name], sc); V.check_zip(store, zips[name])
    for spec in a.reference:
        name, ref = spec.split("=", 1)
        for fn in V.NAMES.values():
            x = pd.read_csv(zipfile.ZipFile(zips[name]).open(fn), sep=" ", header=None)[1]
            y = pd.read_csv(zipfile.ZipFile(ref).open(fn), sep=" ", header=None)[1]
            log(f"{name:6s} {fn:45s} rank-corr with {Path(ref).name}: {x.corr(y, method='spearman'):.4f}")
    log("chosen per file:", dict(zip(D.file, D["mode"])), "->", zips["chosen"])


if __name__ == "__main__":
    main()
'''
_p = WORKDIR / 'repo' / 'BEST/v6_eval/pipeline.py'; _p.parent.mkdir(parents=True, exist_ok=True)
_p.write_text(SRC_BEST_V6_EVAL_PIPELINE_PY, encoding='utf-8'); print('BEST/v6_eval/pipeline.py:', len(SRC_BEST_V6_EVAL_PIPELINE_PY.splitlines()), 'lines')
# <<<FF-CELL>>>
print("[cell] 26 BEST/v7_safe/safe_lib.py (verbatim)", flush=True)
# ============================================================================ BEST/v7_safe/safe_lib.py (verbatim)
SRC_BEST_V7_SAFE_SAFE_LIB_PY = r'''"""BEST v7 (CB 23.28): self-contained library for the Bangla side (B3) of the level-0 system.

Every piece is a verbatim copy of code that was validated before (no import from Experiment/ or kaggle/):
  * Prep / branch / Model / Member.embed+score / RidgeCCA transforms / Std / l2n: LIB cell of kaggle/build_l0_notebooks.py
    (FLAG_18 ... 29, FLAG_24); the s007 XALL member is loaded from members/s007_xall.pt (export_members.py).
  * B3Scorer: DevL0 of the FLAG_24 cell (level-0 constants from 20 000 random train pairs, RandomState(0)) with the
    registered VER-01 weights FIXW, + 0.599 rel + 0.478 relg (Experiment/SAFE-04, log 102).
  * Side / zrow / RelMulti: Experiment/SAFE-04/rel.py.
  * external persons (MAV-Celeb v1/v2): the LOAD cell of build_l0_notebooks.py (persons merged by name, OVERLAP removed,
    genders from the v1 speaker list and the majority of the w2v2 predictions for v2).
A pair's score depends only on that face, that voice, and train constants (level 0).
"""
import os
from pathlib import Path
import numpy as np, pandas as pd
import torch, torch.nn as nn, torch.nn.functional as F

DEVICE = torch.device("cpu")
N_REF = 20000
FIXW = np.array([0.298, 0.405, 0.948, 0.327])          # deep, CCA, ImageBind, age (VER-01, log 91)
W_REL, W_RELG = 0.599, 0.478                           # SAFE-04 (log 102): learned on true-label validation
AGE_MIDS = np.array([1, 6, 15, 25, 35, 45, 55, 65, 75], dtype=np.float32)
OVERLAP = {"v1_complete:shaukat_tarin", "v2_complete:id0073"}   # persons also in v4 (SET-07)
REL_FACES, REL_VOICES = ("farl", "ibf", "ada"), ("ecapa", "btc")
l2n = lambda X: X / (np.linalg.norm(X, axis=1, keepdims=True) + 1e-8)


class Std:
    """z-score with constants measured on the reference train pairs only."""
    def __init__(self, ref):
        self.m, self.s = float(np.mean(ref)), float(np.std(ref) + 1e-9)

    def __call__(self, x):
        return (x - self.m) / self.s


# ============================================================================ bridge (LIB cell, inference only)
class Prep:
    def __init__(self, d):
        self.mf, self.sf, self.mv, self.sv, self.Pf, self.Pv = (d[k] for k in ("mf", "sf", "mv", "sv", "Pf", "Pv"))

    @classmethod
    def fit(cls, Xf, Xv, pca_f=256, pca_v=None):
        """Standardise; PCA the face to 256 (fitted on training rows). = LIB Prep.__init__."""
        mf, sf = Xf.mean(0), Xf.std(0) + 1e-6
        mv, sv = Xv.mean(0), Xv.std(0) + 1e-6
        return cls(dict(mf=mf, sf=sf, mv=mv, sv=sv, Pf=cls._pca((Xf - mf) / sf, pca_f), Pv=cls._pca((Xv - mv) / sv, pca_v)))

    @staticmethod
    def _pca(Z, k):
        if not k or k >= Z.shape[1]:
            return None
        _, _, Vt = np.linalg.svd(Z.astype(np.float64), full_matrices=False)
        return Vt[:k].T.astype(np.float32)

    def f(self, X):
        Z = (X - self.mf) / self.sf
        return (Z if self.Pf is None else Z @ self.Pf).astype(np.float32)

    def v(self, X):
        Z = (X - self.mv) / self.sv
        return (Z if self.Pv is None else Z @ self.Pv).astype(np.float32)


def branch(d_in, emb, drop, hid):
    return nn.Sequential(nn.Dropout(drop), nn.Linear(d_in, hid), nn.BatchNorm1d(hid), nn.ReLU(), nn.Dropout(drop), nn.Linear(hid, emb))


class Model(nn.Module):
    def __init__(self, d_f, d_v, n_cls, cfg):
        super().__init__()
        self.bf = branch(d_f, cfg["emb"], cfg["drop"], cfg["hid"])
        self.bv = branch(d_v, cfg["emb"], cfg["drop"], cfg["hid"])
        self.W = nn.Parameter(torch.randn(n_cls, cfg["emb"]) * 0.01)
        self.gdisc = nn.Sequential(nn.Linear(cfg["emb"], 64), nn.ReLU(), nn.Linear(64, 2))
        self.ldisc = nn.Sequential(nn.Linear(cfg["emb"], 64), nn.ReLU(), nn.Linear(64, 2))

    def forward(self, f, v):
        return F.normalize(self.bf(f), dim=1), F.normalize(self.bv(v), dim=1)

    def ef(self, x): return F.normalize(self.bf(x), dim=1)
    def ev(self, x): return F.normalize(self.bv(x), dim=1)
    def score(self, a, b): return (a * b).sum(1)


class XallMember:
    """The 5 s007 XALL nets + CCA-4 of CB 23.28, rebuilt from members/s007_xall.pt."""
    def __init__(self, units, cca):
        self.units, self.c = units, cca

    @classmethod
    def load(cls, path):
        d = torch.load(path, weights_only=False, map_location="cpu")
        cfg = d["cfg"]["B_REC"]
        units = []
        for u in d["units"]:
            prep = Prep(u["prep"])
            d_f = prep.Pf.shape[1] if prep.Pf is not None else len(prep.mf)
            d_v = prep.Pv.shape[1] if prep.Pv is not None else len(prep.mv)
            net = Model(d_f, d_v, d["n_cls"], cfg)
            net.load_state_dict(u["state"]); net.eval()
            units.append((net, prep))
        return cls(units, d["cca"])

    @torch.no_grad()
    def embed(self, i, Xf, Xv, chunk=4096):
        net, prep = self.units[i]
        E = []
        for X, fn, pf in ((Xf, net.ef, prep.f), (Xv, net.ev, prep.v)):
            E.append(torch.cat([fn(torch.tensor(pf(X[j:j + chunk]), device=DEVICE)) for j in range(0, len(X), chunk)]))
        return E

    @torch.no_grad()
    def score(self, i, Ef, Ev, chunk=8192):
        net = self.units[i][0]
        return torch.cat([net.score(Ef[j:j + chunk], Ev[j:j + chunk]) for j in range(0, len(Ef), chunk)]).float().cpu().numpy()

    def pair(self, i, Xf, Xv):
        return self.score(i, *self.embed(i, Xf, Xv))

    def cca_x(self, X):
        c = self.c
        return l2n((((X - c["mx"]) / c["sx"]) @ c["Px"]) @ c["Wx"])

    def cca_y(self, Y):
        c = self.c
        return l2n((((Y - c["my"]) / c["sy"]) @ c["Py"]) @ c["Wy"])


# ============================================================================ relational bridge (Experiment/SAFE-04/rel.py)
class Side:
    """One modality / one encoder: identity centroids + per-identity column statistics from TRAIN samples of the other
    identities (removes hub centroids)."""
    def __init__(self, ids, rows_per_id, colnorm=True, max_rows=40, seed=0):
        self.ids = list(ids)
        C = np.stack([l2n(np.asarray(r, np.float32)).mean(0) for r in rows_per_id])
        self.c = C.mean(0); self.C = l2n(C - self.c)
        self.mu = self.sd = None
        if colnorm:
            rng = np.random.RandomState(seed)
            X, who = [], []
            for i, r in enumerate(rows_per_id):
                r = np.asarray(r, np.float32)
                take = r if len(r) <= max_rows else r[rng.choice(len(r), max_rows, replace=False)]
                X.append(take); who += [i] * len(take)
            P = self.raw(np.concatenate(X)); who = np.asarray(who)
            other = who[:, None] != np.arange(len(self.ids))[None, :]
            n = other.sum(0)
            self.mu = np.where(other, P, 0).sum(0) / n
            self.sd = np.sqrt(np.where(other, (P - self.mu) ** 2, 0).sum(0) / n) + 1e-6

    def raw(self, X):
        return l2n(l2n(np.asarray(X, np.float32)) - self.c) @ self.C.T

    def __call__(self, X):
        P = self.raw(X)
        return P if self.mu is None else (P - self.mu) / self.sd


def zrow(P, mask):
    n = mask.sum(1, keepdims=True)
    m = np.where(mask, P, 0).sum(1, keepdims=True) / n
    s = np.sqrt(np.where(mask, (P - m) ** 2, 0).sum(1, keepdims=True) / n) + 1e-9
    return np.where(mask, (P - m) / s, 0)


class RelMulti:
    """Profiles of several face encoders averaged (after per-sample z), same for voices; score = correlation."""
    def __init__(self, face_sides, voice_sides):
        self.F, self.V = face_sides, voice_sides
        self.ids = face_sides[0].ids
        assert all(s.ids == self.ids for s in face_sides + voice_sides)
        self.col = {p: i for i, p in enumerate(self.ids)}

    def _score(self, Xfs, Xvs, mask):
        Pf = zrow(np.mean([zrow(s(X), mask) for s, X in zip(self.F, Xfs)], 0), mask)
        Pv = zrow(np.mean([zrow(s(X), mask) for s, X in zip(self.V, Xvs)], 0), mask)
        return (Pf * Pv).sum(1) / mask.sum(1)

    def score(self, Xfs, Xvs, pf=None, pv=None, chunk=4096, keep=None):
        out = []
        n = len(Xfs[0])
        for i in range(0, n, chunk):
            sl = slice(i, i + chunk)
            m = np.ones((len(Xfs[0][sl]), len(self.ids)), dtype=bool) if keep is None else keep[sl].copy()
            if pf is not None:
                for j, (a, b) in enumerate(zip(pf[sl], pv[sl])):
                    for p in (a, b):
                        if p in self.col:
                            m[j, self.col[p]] = False
            out.append(self._score([X[sl] for X in Xfs], [X[sl] for X in Xvs], m))
        return np.concatenate(out)


def pmale(g3):
    """w2v2 audeering age-gender head, columns (female, male, child) -> P(male | adult)."""
    g = np.asarray(g3, np.float64)
    return g[:, 1] / (g[:, 0] + g[:, 1] + 1e-9)


# ============================================================================ external persons (LOAD cell)
def load_ext(find):
    """find(name) -> path of an external array / table. Returns FMETA, VMETA (one row per v1+v2 face / voice, v1 then
    v2), GEN (person -> 'm' / 'f') and the ext arrays needed here (face vgg / ibv / farl / adaface, voice btc / ecapa192 /
    w2v2aggen), all float32 after a float16 round trip (the external arrays of the eda bundle are float16, so the
    result does not depend on which copy is attached)."""
    FM_, VM_, GEN, arr = [], [], {}, {}
    names = {"face": {"vgg": ("face_vgg", "face"), "ibf": ("face_ibv",), "farl": ("face_farl",), "ada": ("face_adaface",)},
             "voice": {"btc": ("voice_btc", "voice"), "ecapa": ("voice_ecapa192",), "w2v2aggen": ("voice_w2v2aggen",)}}
    for src in ("v1_complete", "v2_complete"):
        fm, vm = pd.read_csv(find(f"ext_{src}_face_meta.csv")), pd.read_csv(find(f"ext_{src}_voice_meta.csv"))
        key_of = {}
        sp = find(f"ext_{src}_speakers.csv", required=False)
        if sp is not None:
            for r in pd.read_csv(sp).itertuples():
                k = f"{src}:" + str(r.name).strip().lower().replace(" ", "_")
                key_of[r.ids] = k
                GEN[k] = "m" if str(r.gender).lower().startswith("m") else "f"
        key = lambda x, key_of=key_of, src=src: key_of.get(x, f"{src}:{x}")
        FM_.append(fm.assign(p=fm.spk.map(key), src=src)); VM_.append(vm.assign(p=vm.spk.map(key), src=src))
        for kind, d in names.items():
            for k, alts in d.items():
                f = next((find(f"ext_{src}_{a}.npy", required=False) for a in alts if find(f"ext_{src}_{a}.npy", required=False)), None)
                assert f is not None, f"ext_{src}_{alts[0]}.npy not found"
                a = np.load(f).astype(np.float16).astype(np.float32)     # as stored in flag2027-eda-bundle
                assert len(a) == len(fm if kind == "face" else vm), (src, k, len(a))
                arr.setdefault((kind, k), []).append(a)
    FMETA, VMETA = pd.concat(FM_, ignore_index=True), pd.concat(VM_, ignore_index=True)
    arr = {k: np.concatenate(v) for k, v in arr.items()}
    male = arr[("voice", "w2v2aggen")][:, 1] > arr[("voice", "w2v2aggen")][:, 0]
    for p, g in VMETA.assign(m=male).groupby("p").m.mean().items():
        GEN.setdefault(p, "m" if g >= .5 else "f")
    if os.environ.get("LID_STRICT") == "1":      # CLEANCOMP-01 (3/11, opt-in): MAV voice files with a Whisper vote leave XALL training rows + rel anchors
        drop = set(strict_mav_files())           # (faces stay; GEN above was fixed from all calls; unset = unchanged bit for bit)
        key = VMETA.path if VMETA.path.str.startswith(("v1/", "v2/")).all() else VMETA.src.str[:2] + "/" + VMETA.path   # lid_strict.json names 'v1/voices/..'
        m = ~key.isin(drop).values
        print(f"[CLEANCOMP-01] LID_STRICT MAV voice files dropped: {int((~m).sum())} of {len(drop)} listed ({len(VMETA)} rows)", flush=True)
        assert 0 < int((~m).sum()), "LID_STRICT=1 but no listed MAV voice file matched VMETA.path"
        VMETA = VMETA[m].reset_index(drop=True)
        for k in [k for k in arr if k[0] == "voice"]:
            arr[k] = arr[k][m]
    return FMETA, VMETA, GEN, arr


def strict_mav_files():
    """lid_strict.json 'mav_files' (LIDSTRICT-01): next to the repo, or any attached dataset."""
    import json
    c = [Path(__file__).resolve().parents[2] / "Experiment/LIDSTRICT-01/lid_strict.json"]
    if Path("/kaggle/input").exists():
        c += list(Path("/kaggle/input").rglob("lid_strict.json"))
    hit = [q for q in c if q.exists()]
    assert hit, "LID_STRICT=1 needs lid_strict.json"
    return json.loads(hit[0].read_text())["mav_files"]


# ============================================================================ the Bangla-side scorer (B3)
class B3Scorer:
    """s007 XALL with the registered weights + relational bridge, level 0.

    TR: dict of train arrays, all v4 rows in organiser order: vgg, btc, ibf, iba, agef, agev, farl, ada, ecapa, vgen.
    spk / gmap: train persons and genders. ext = load_ext(...)."""
    def __init__(self, member, TR, spk, gmap, ext, log=print):
        self.mem, self.TR = member, TR
        FMETA, VMETA, GEN, EA = ext
        persons = sorted(set(VMETA.p) - OVERLAP)
        GM = dict(gmap); [GM.setdefault(k, v) for k, v in GEN.items()]
        n = len(spk)
        rr = np.random.RandomState(0)
        self.rf, self.rv = rf, rv = rr.randint(n, size=N_REF), rr.randint(n, size=N_REF)
        # ---- bridge streams: constants exactly as DevL0 (FLAG_24)
        self.sd = []
        for i in range(len(member.units)):
            Ef, Ev = member.embed(i, TR["vgg"], TR["btc"])
            self.sd.append(Std(member.score(i, Ef[rf], Ev[rv])))
        self.zc = Std(np.sum(member.cca_x(TR["vgg"])[rf] * member.cca_y(TR["btc"])[rv], 1))
        self.mf, self.mv = TR["ibf"].mean(0), TR["iba"].mean(0)
        self.zib = Std(np.sum(l2n(TR["ibf"][rf] - self.mf) * l2n(TR["iba"][rv] - self.mv), 1))
        self.zag = Std(-np.abs(TR["agef"][rf] - TR["agev"][rv]))
        if os.environ.get("NOREL") == "1":   # NOREL-01 (5/11, BTC Rules & FAQ: no train-identity cohort at test time): no anchors are
            self.rel = None                   # built, relational() returns zeros, the composite constants leave rel / relg out
            T_ref = {k: TR[k][rf] for k in ("vgg", "ibf", "agef")}
            T_ref.update({k: TR[k][rv] for k in ("btc", "iba", "agev")})
            b_ref = self.streams(T_ref) @ FIXW
            self.zb = Std(b_ref); self.zf = Std(self.zb(b_ref))
            log(f"B3 (NOREL=1): {len(member.units)} nets, no relational anchors (rel / relg columns = 0, never fused)")
            return
        # ---- relational bridge: anchors = every v4 person (all rows) + every v1/v2 person with faces and voices
        fp, vp = FMETA.p.values, VMETA.p.values
        ext_ok = [p for p in persons if (fp == p).any() and (vp == p).any()]
        tr_key = {"farl": "farl", "ibf": "ibf", "ada": "ada", "ecapa": "ecapa", "btc": "btc"}
        ext_key = {"farl": ("face", "farl"), "ibf": ("face", "ibf"), "ada": ("face", "ada"), "ecapa": ("voice", "ecapa"), "btc": ("voice", "btc")}

        def rows(k):
            kind = ext_key[k][0]
            meta_p = fp if kind == "face" else vp
            out = [(p, TR[tr_key[k]][spk == p]) for p in np.unique(spk)]
            out += [(p, EA[ext_key[k]][np.where(meta_p == p)[0]]) for p in ext_ok]
            return out
        sides = [[Side([a for a, _ in g], [b for _, b in g]) for g in [rows(k) for k in ks]] for ks in (REL_FACES, REL_VOICES)]
        self.rel = RelMulti(*sides)
        self.amale = np.array([GM.get(p) == "m" for p in self.rel.ids])
        ref_f = [TR[tr_key[k]][rf] for k in REL_FACES]; ref_v = [TR[tr_key[k]][rv] for k in REL_VOICES]
        r0 = self.rel.score(ref_f, ref_v, spk[rf], spk[rv])
        rg = self.rel.score(ref_f, ref_v, spk[rf], spk[rv], keep=self.keep(TR["vgen"][rv]))
        self.zrel, self.zrelg = Std(r0), Std(rg)
        # ---- final constants on the reference pairs
        T_ref = {k: TR[k][rf] for k in ("vgg", "ibf", "agef")}
        T_ref.update({k: TR[k][rv] for k in ("btc", "iba", "agev")})
        b_ref = self.streams(T_ref) @ FIXW + W_REL * self.zrel(r0) + W_RELG * self.zrelg(rg)
        self.zb = Std(b_ref); self.zf = Std(self.zb(b_ref))
        log(f"B3: {len(member.units)} nets, {len(self.rel.ids)} relational anchors ({int(self.amale.sum())} male), "
            f"{len(ext_ok)} external persons")

    def keep(self, vgen):
        return self.amale[None, :] == (pmale(vgen) > 0.5)[:, None]

    def streams(self, T):
        m = self.mem
        deep = np.mean([sd(m.pair(i, T["vgg"], T["btc"])) for i, sd in enumerate(self.sd)], 0)
        cca = self.zc(np.sum(m.cca_x(T["vgg"]) * m.cca_y(T["btc"]), 1))
        ib = self.zib(np.sum(l2n(T["ibf"] - self.mf) * l2n(T["iba"] - self.mv), 1))
        age = self.zag(-np.abs(T["agef"] - T["agev"]))
        return np.stack([deep, cca, ib, age], 1)

    def relational(self, T):
        if self.rel is None:                  # NOREL=1
            n = len(T["vgen"]); return np.zeros(n), np.zeros(n)
        Xf, Xv = [T[k] for k in REL_FACES], [T[k] for k in REL_VOICES]
        return self.zrel(self.rel.score(Xf, Xv)), self.zrelg(self.rel.score(Xf, Xv, keep=self.keep(T["vgen"])))

    def __call__(self, T):
        """T: row-aligned trial arrays vgg, btc, ibf, iba, agef, agev, farl, ada, ecapa, vgen. Higher = same."""
        r, rg = self.relational(T)
        return self.zf(self.zb(self.streams(T) @ FIXW + W_REL * r + W_RELG * rg))


def face_gender_model(ibf_train, spk, gmap, ext):
    """P(male) of a face: logistic regression on L2-normalised ImageBind faces of every train face (v4 rows + MAV-Celeb
    v1/v2 faces). Shared by CAFuse (Bangla) and CA-EN (English, BEST v9). -> (model, number of train faces)"""
    from sklearn.linear_model import LogisticRegression
    FMETA, VMETA, GEN, EA = ext
    GM = dict(gmap); [GM.setdefault(k, v) for k, v in GEN.items()]
    X = np.concatenate([ibf_train, np.asarray(EA[("face", "ibf")], np.float32)])
    y = np.concatenate([[GM.get(p) == "m" for p in spk], [GM.get(p) == "m" for p in FMETA.p.values]])
    return LogisticRegression(C=1.0, max_iter=3000).fit(l2n(X), y), len(y)


class CAFuse:
    """Condition-aware fusion of the B3 streams (Experiment/CAFUSE-01, log 112-113; CB dev Bangla 18.07 / 28.07).

    Logistic regression, fitted ONCE on the SAFE-04 true-label validation trials (cafuse_fuser.json), on
      6 B3 streams   [deep, cca, ib, age, rel, relg]   (B3Scorer.streams + B3Scorer.relational)
      7 conditions   [file language English, P(male) face, P(male) voice, |difference|, age face, age voice, |age gap|]
      their 42 products.
    P(male) face: logistic regression on L2-normalised ImageBind faces of every train face (v4 rows + MAV-Celeb v1/v2
    faces); P(male) voice: w2v2 gender head. Every input comes from the pair itself, its file's language and train
    constants, so the score stays level 0."""
    def __init__(self, b3, model, TR, spk, gmap, ext, log=print):
        self.b3, self.m = b3, model
        self.mean, self.scale, self.coef = (np.array(model[k], np.float64) for k in ("mean", "scale", "coef"))
        self.gclf, n = face_gender_model(TR["ibf"], spk, gmap, ext)
        log(f"CA-FUSE: {len(self.coef)} inputs, fitted on {model.get('n_trials')} validation trials; face gender model on {n} train faces")

    def conditions(self, T, is_en):
        pf, pv = self.gclf.predict_proba(l2n(T["ibf"]))[:, 1], pmale(T["vgen"])
        return np.stack([np.full(len(pf), float(is_en)), pf, pv, np.abs(pf - pv), T["agef"], T["agev"],
                         np.abs(T["agef"] - T["agev"])], 1)

    def __call__(self, T, is_en):
        """Higher = same."""
        r, rg = self.b3.relational(T)
        Z = np.concatenate([self.b3.streams(T), r[:, None], rg[:, None]], 1)
        C = self.conditions(T, is_en)
        X = np.concatenate([Z, C, (Z[:, :, None] * C[:, None, :]).reshape(len(Z), -1)], 1)
        return ((X - self.mean) / self.scale) @ self.coef + self.m["intercept"]



# ============================================================================ training (rebuild members from raw data)
# Verbatim from kaggle/build_l0_notebooks.py (LIB: REC, infonce, pk_batches, train_one, epochs_for, RidgeCCA; DATA: ext_rows;
# DEV_RUN: train_s007(ext=True)). Same RNG calls, so on the same machine and thread count the nets are bit-identical.
REC = dict(pca_f=256, pca_v=None, hid=512, emb=128, drop=0.3, lr=1e-3, wd=1e-2, tau=0.07, epochs=40)
P_PK, K_PK, CAP, STEPS, N_NETS = 32, 8, 150, 1200, 5
TRAIN_DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")


def infonce_S(S, y):
    same = (y[:, None] == y[None, :]).float()
    return 0.5 * ((-(F.log_softmax(S, 1) * same).sum(1) / same.sum(1)).mean() +
                  (-(F.log_softmax(S, 0) * same).sum(0) / same.sum(0)).mean())


def infonce(u, w, y, tau):
    return infonce_S(u @ w.T / tau, y)


def pk_batches(spk_idx, P, K, n_rows, rng):
    speakers = list(spk_idx)
    out = []
    for _ in range(max(1, n_rows // (P * K))):
        chosen = rng.choice(len(speakers), size=min(P, len(speakers)), replace=False)
        out.append(np.concatenate([rng.choice(spk_idx[speakers[c]], size=K, replace=len(spk_idx[speakers[c]]) < K)
                                   for c in chosen]))
    return out


def train_one(TF, TV, spk, seed, epochs, P=P_PK, K=K_PK, device=None):
    """EXP-007 MLP, InfoNCE, PK sampler, AdamW + cosine (LIB train_one)."""
    DEV = device or TRAIN_DEVICE
    cfg = dict(REC, epochs=epochs)
    torch.manual_seed(seed); np.random.seed(seed)
    rng = np.random.RandomState(seed)
    prep = Prep.fit(TF, TV, cfg["pca_f"], cfg["pca_v"])
    Ftr = torch.tensor(prep.f(TF), device=DEV)
    Vv = torch.stack([torch.tensor(prep.v(TV), device=DEV)])
    cls = {s: i for i, s in enumerate(np.unique(spk))}
    Y = torch.tensor([cls[s] for s in spk], device=DEV)
    net = Model(Ftr.shape[1], Vv.shape[2], len(cls), cfg).to(DEV)
    opt = torch.optim.AdamW(net.parameters(), lr=cfg["lr"], weight_decay=cfg["wd"])
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, cfg["epochs"])
    n = len(spk)
    spk_idx = {s: np.where(np.asarray(spk) == s)[0] for s in np.unique(spk)}
    P = min(P, len(spk_idx))
    for ep in range(cfg["epochs"]):
        net.train()
        rng.permutation(n); vsel = np.zeros(n, dtype=int)                 # same RNG calls as flag_v2 (full view)
        for b in pk_batches(spk_idx, P, K, n, rng):
            bt = torch.tensor(b, device=DEV); vt = torch.tensor(vsel[b], device=DEV)
            u, w = net(Ftr[bt], Vv[vt, bt])
            loss = infonce(u, w, Y[bt], cfg["tau"])
            opt.zero_grad(); loss.backward(); opt.step()
        sched.step()
    net.eval()
    return net.cpu(), prep


def epochs_for(n_rows, steps=None):
    bpe = max(1, n_rows // (P_PK * K_PK))
    return max(1, int(round((steps or STEPS) / bpe))), bpe


def cca_fit(X, Y, k=4, reg=1.0, pca_x=128, pca_y=192):
    """RidgeCCA(k=4, reg=1, pca 128 / 192).fit -> the parameter dict XallMember uses (LIB RidgeCCA)."""
    def _prep(Z0, n_pca):
        mu, sd = Z0.mean(0), Z0.std(0) + 1e-6
        Z = (Z0 - mu) / sd
        if n_pca is not None and n_pca < Z.shape[1]:
            _, _, Vt = np.linalg.svd(Z, full_matrices=False); P = Vt[:n_pca].T
        else:
            P = np.eye(Z.shape[1])
        return mu, sd, P
    mx, sx, Px = _prep(X, min(pca_x, X.shape[1]) if pca_x else None)
    my, sy, Py = _prep(Y, min(pca_y, Y.shape[1]) if pca_y else None)
    A_ = ((X - mx) / sx) @ Px; B_ = ((Y - my) / sy) @ Py
    n = len(A_)
    Cxx = A_.T @ A_ / n + reg * np.eye(A_.shape[1]); Cyy = B_.T @ B_ / n + reg * np.eye(B_.shape[1])
    Lxi = np.linalg.inv(np.linalg.cholesky(Cxx)); Lyi = np.linalg.inv(np.linalg.cholesky(Cyy))
    U, S_, Vt = np.linalg.svd(Lxi @ (A_.T @ B_ / n) @ Lyi.T, full_matrices=False)
    return dict(mx=mx, sx=sx, Px=Px, Wx=Lxi.T @ U[:, :k], my=my, sy=sy, Py=Py, Wy=Lyi.T @ Vt[:k].T)


def ext_rows(FMETA, VMETA, FA_vgg, VA_btc, persons, rng, cap=CAP):
    """Organiser-space training rows of external persons (DATA ext_rows, xvid=False): one per voice clip (<= cap per
    person), paired with a face of the SAME video (cycling; any face of the person if that video has none)."""
    vm = VMETA[VMETA.p.isin(persons)]
    fm = FMETA[FMETA.p.isin(persons)]
    by_vid = {k: np.asarray(g.index) for k, g in fm.groupby(["p", "lang", "video"])}
    by_p = {k: np.asarray(g.index) for k, g in fm.groupby("p")}
    Fi, Vi, S = [], [], []
    for p, g in vm.groupby("p"):
        if p not in by_p:
            continue
        idx = np.asarray(g.index)
        if len(idx) > cap:
            idx = rng.choice(idx, cap, replace=False)
        for j, i in enumerate(idx):
            cand = by_vid.get((p, VMETA.lang[i], VMETA.video[i]), by_p[p])
            Fi.append(cand[j % len(cand)])
            Vi.append(i); S.append(p)
    return FA_vgg[Fi], VA_btc[Vi], np.array(S)


def train_xall(v4_vgg, v4_btc, v4_spk, ext, log=print, device=None):
    """s007 XALL of CB 23.28 (FLAG_24 train_s007(ext=True)): 70 v4 + every v1/v2 person (OVERLAP removed), <= 150 rows
    each, PK 32 x 8, 1200 steps, 5 nets (seeds 1 + 100 i) + CCA-4 on the same rows."""
    import time as _t
    FMETA, VMETA, GEN, EA = ext
    persons = sorted(set(VMETA.p) - OVERLAP)
    EF, EV, ES = ext_rows(FMETA, VMETA, EA[("face", "vgg")], EA[("voice", "btc")], persons, np.random.RandomState(4000))
    TF, TV, TS = np.concatenate([v4_vgg, EF]), np.concatenate([v4_btc, EV]), np.concatenate([np.asarray(v4_spk), ES])
    ep, bpe = epochs_for(len(TS))
    t0 = _t.time()
    units = [train_one(TF, TV, TS, seed=1 + 100 * i, epochs=ep, device=device) for i in range(N_NETS)]
    log(f"s007 XALL: {len(set(TS))} persons, {len(TS)} rows, {ep * bpe} steps x {N_NETS} nets [{_t.time() - t0:.0f}s]")
    return XallMember(units, cca_fit(TF, TV))


def save_xall(member, path):
    """Same format as export_members.py."""
    units = [{"state": {k: v.detach().cpu().clone() for k, v in net.state_dict().items()},
              "prep": {k: getattr(prep, k) for k in ("mf", "sf", "mv", "sv", "Pf", "Pv")}} for net, prep in member.units]
    torch.save({"units": units, "cca": member.c, "cfg": dict(B_REC=REC), "n_cls": units[0]["state"]["W"].shape[0],
                "source": "safe_lib.train_xall"}, path)
'''
_p = WORKDIR / 'repo' / 'BEST/v7_safe/safe_lib.py'; _p.parent.mkdir(parents=True, exist_ok=True)
_p.write_text(SRC_BEST_V7_SAFE_SAFE_LIB_PY, encoding='utf-8'); print('BEST/v7_safe/safe_lib.py:', len(SRC_BEST_V7_SAFE_SAFE_LIB_PY.splitlines()), 'lines')
# <<<FF-CELL>>>
print("[cell] 27 Experiment/E2E/system_v11.py (verbatim)", flush=True)
# ============================================================================ Experiment/E2E/system_v11.py (verbatim)
SRC_EXPERIMENT_E2E_SYSTEM_V11_PY = r'''r"""System v11 on any test split (dev now, the Evaluation data on 11/11): per test file, the components of the current
system and the v9 / v11 scores (docs/PLAN_E2E_2026-10-10.md). Used by
  * kaggle/build_e2e_dev_bundle.py   (local: dev components from the arrays on this machine -> flag2027-e2e-dev)
  * FLAG_50_e2e_v11.ipynb            (Kaggle: freshly extracted arrays -> submission.zip + components_<split>.npz)
Components of file i: B3 (6 streams of BEST v9's Bangla side), CO (7 CA-FUSE conditions, is_en from the file language),
EN7 + ENCO (CA-EN streams + 6 conditions of v9's English side), T3 (anP512_deep, anP512_cca, t3_relg of v11's head; given),
w2v2 gender probabilities. Scores: v9 = CA-EN (English) / CA-FUSE (Bangla); v11 = v9 English / CA-FUSE + T3 (Bangla).
Every quantity of a pair depends only on that pair and train constants (level 0); `selftest` re-scores half of every file.
"""
import importlib.util, json, os, sys, time
from pathlib import Path
import numpy as np, pandas as pd

R0 = Path(__file__).resolve().parents[2]
B3_COLS = ["deep", "cca", "ib", "age", "rel", "relg"]
CO_COLS = ["is_en", "pf_m", "pv_m", "gdiff", "agef", "agev", "agegap"]
EN7_COLS = ["s007_deep", "s007_cca", "s010B_deep", "s010B_cca", "ib", "age", "acl"]
ENCO_COLS = ["pf_m", "pv_m", "gdiff", "agef", "agev", "agegap"]
T3_COLS = ["anP512_deep", "anP512_cca", "t3_relg"]
design = lambda Z, C: np.concatenate([Z, C, (Z[:, :, None] * C[:, None, :]).reshape(len(Z), -1)], 1)


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def _load(name, path):
    spec = importlib.util.spec_from_file_location(name, path); m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
    return m


def apply(model, Z, C):
    m = {k: np.array(model[k], np.float64) for k in ("mean", "scale", "coef")}
    return ((design(Z, C) - m["mean"]) / m["scale"]) @ m["coef"] + model["intercept"]


class System:
    """B3 + CA-EN component scorers on a FeatureStore (data = organiser csv / lists, feats = array folders)."""
    def __init__(self, data, feats, ext_dirs, xall_pt, v6_members, fuser_b9, threads=10, n_models=5):
        sys.path[:0] = [str(R0 / "BEST/v7_safe"), str(R0 / "BEST/v6_eval"), str(R0 / "kaggle")]
        import safe_lib as S
        import flag_v2 as V
        import torch
        torch.set_num_threads(threads)
        # the cached v6 members (s007 / s010B) are CPU tensors; flag_v2 sends inputs to cuda when a GPU exists (FLAG_50 on
        # Kaggle, 11/10: "mat1 is on cuda:0, other tensors on cpu"). Every component runs on CPU, as the submitted zips did.
        V.DEVICE = torch.device("cpu")
        if "flag_lib" in sys.modules:
            sys.modules["flag_lib"].DEVICE = V.DEVICE
        self.S, self.V = S, V
        P6 = _load("v6p", R0 / "BEST/v6_eval/pipeline.py")
        P6.CONFIG["members"] = {k: v for k, v in P6.CONFIG["members"].items() if k in ("s007", "s010B")}
        os.environ["FLAG_FEATS_EXTRA"] = os.pathsep.join(str(p) for p in feats[1:])
        self.store = store = V.FeatureStore(str(data), feats_dir=str(feats[0]))
        npy = self.npy = lambda stem, split: store._npy(stem, split).astype(np.float32)

        def find(name, required=True):
            for d in ext_dirs:
                for f in (Path(d) / name, *Path(d).glob(f"*/{name}")):
                    if f.exists():
                        return f
            assert not required, name
            return None
        ext = S.load_ext(find)
        self.b3 = S.B3Scorer(S.XallMember.load(xall_pt), self.arrays("train"), store.spk, store.gmap, ext, log=log)
        self.ca9 = S.CAFuse(self.b3, fuser_b9, self.arrays("train"), store.spk, store.gmap, ext, log=log)
        M = P6.train_members(V, store, n_models, Path(v6_members))
        rng = np.random.RandomState(0); n = len(store.spk)
        REF = (rng.randint(n, size=P6.CONFIG["ref_pairs"]), rng.randint(n, size=P6.CONFIG["ref_pairs"]))
        self.SC = {m: P6.Scorer(V, store, cfg, nets, REF) for m, (cfg, nets) in M.items()}
        self.pair, Std = P6.pair, P6.Std
        Fi_tr, Ai_tr = npy("face_ibv", "train"), npy("voice_iba", "train")
        self.mib = (Fi_tr.mean(0), Ai_tr.mean(0))
        self.age_f = lambda sp: npy("face_vitageprob", sp) @ P6.AGE_MIDS
        self.age_v = lambda sp: npy("voice_w2v2agage", sp)[:, 0] * 100
        self.zib = Std(self.ib0(Fi_tr[REF[0]], Ai_tr[REF[1]]))
        self.zag = Std(-np.abs(self.age_f("train")[REF[0]] - self.age_v("train")[REF[1]]))
        Fa_tr, Aa_tr = npy("face_aclip", "train"), npy("voice_aclip", "train")
        self.macl = (Fa_tr.mean(0), Aa_tr.mean(0))
        self.zacl = Std(self.acl0(Fa_tr[REF[0]], Aa_tr[REF[1]]))
        self.cells = [("/".join(k), k) for k in V.CELLS]

    def ib0(self, F_, A_):
        return self.pair(self.V.l2n(F_ - self.mib[0]), self.V.l2n(A_ - self.mib[1]))

    def acl0(self, F_, A_):
        return self.pair(self.V.l2n(F_ - self.macl[0]), self.V.l2n(A_ - self.macl[1]))

    def arrays(self, split):
        S, store, npy = self.S, self.store, self.npy
        return dict(vgg=store.face("vgg", split), btc=store.voice("given", split), ibf=npy("face_ibv", split),
                    iba=npy("voice_iba", split), agef=npy("face_vitageprob", split) @ S.AGE_MIDS,
                    agev=npy("voice_w2v2agage", split)[:, 0] * 100, farl=npy("face_farl", split),
                    ada=npy("face_adaface", split), ecapa=npy("voice_ecapa192", split), vgen=npy("voice_w2v2aggen", split))

    def b3_co(self, split, is_en, rows=None):
        T = self.arrays(split)
        if rows is not None:
            T = {k: v[rows] for k, v in T.items()}
        r, rg = self.b3.relational(T)
        return np.concatenate([self.b3.streams(T), r[:, None], rg[:, None]], 1), self.ca9.conditions(T, is_en=is_en)

    def en(self, split, rows=None):
        S, npy = self.S, self.npy
        tk = (lambda X: X) if rows is None else (lambda X: X[rows])
        Z = []
        for m in ("s007", "s010B"):
            Af, Av = map(tk, self.SC[m].rows(split))
            Z.append(np.mean([sd(self.pair(*self.SC[m].embed0(net, prep, Af, Av))) for (net, prep), sd in zip(self.SC[m].nets, self.SC[m].stds)], 0))
            Z.append(self.SC[m].cstd(self.pair(self.SC[m].cca.transform_x(Af), self.SC[m].cca.transform_y(Av))))
        af, av = tk(self.age_f(split)), tk(self.age_v(split))
        Z += [self.zib(self.ib0(tk(npy("face_ibv", split)), tk(npy("voice_iba", split)))), self.zag(-np.abs(af - av)),
              self.zacl(self.acl0(tk(npy("face_aclip", split)), tk(npy("voice_aclip", split))))]
        pf = self.ca9.gclf.predict_proba(S.l2n(tk(npy("face_ibv", split))))[:, 1]; pv = S.pmale(tk(npy("voice_w2v2aggen", split)))
        return np.stack(Z, 1), np.stack([pf, pv, np.abs(pf - pv), af, av, np.abs(af - av)], 1)

    def file_components(self, c, k):
        """Components of one test file (c = 'no_gender/English', k = its key)."""
        is_en = k[1] == "English"
        B3, CO = self.b3_co(c, is_en)
        EN7, ENCO = self.en(c)
        return dict(key=c, zip_name=self.V.NAMES[k], protocol=k[0], lang=k[1], is_en=is_en,
                    pid=self.store.dev[k][2].pair_id.to_numpy(dtype=str), b3=B3, co=CO, en7=EN7, enco=ENCO,
                    vgen=self.npy("voice_w2v2aggen", c))

    def selftest(self, c, k, seed=1):
        """Level 0: the components of a random half of the file, computed alone, equal the full-file ones."""
        n = len(self.store.dev[k][2]); half = np.sort(np.random.RandomState(seed).choice(n, n // 2, replace=False))
        B3, CO = self.b3_co(c, k[1] == "English"); B3h, COh = self.b3_co(c, k[1] == "English", half)
        EN7, ENCO = self.en(c); EN7h, ENCOh = self.en(c, half)
        return float(max(np.abs(B3h - B3[half]).max(), np.abs(COh - CO[half]).max(), np.abs(EN7h - EN7[half]).max(),
                         np.abs(ENCOh - ENCO[half]).max()))


def scores(comp, fusers):
    """v9 and v11 scores (higher = same) of one file's components; fusers = {v9_bangla, v9_english, v11_bangla}."""
    if comp["is_en"]:
        v9 = apply(fusers["v9_english"], comp["en7"], comp["enco"])
        return v9, v9
    v9 = apply(fusers["v9_bangla"], comp["b3"], comp["co"])
    v11 = apply(fusers["v11_bangla"], np.concatenate([comp["b3"], comp["t3"]], 1), comp["co"])
    return v9, v11


def v12_scores(comp, fusers):
    """v12 (EN-T3-01, CB 22.29): English = CA_EN_T3 (CA-EN streams + v11's T3 streams), Bangla = v11."""
    if comp["is_en"]:
        return apply(fusers["v12_english"], np.concatenate([comp["en7"], comp["t3"]], 1), comp["enco"])
    return scores(comp, fusers)[1]


def save_components(path, comps, extra=None):
    """comps = {i: component dict} -> one npz (keys <name>_<i>) in the layout e2e_lib.components() reads."""
    out = {}
    for i, c in comps.items():
        for k, v in c.items():
            if isinstance(v, np.ndarray):
                out[f"{k}_{i}"] = v.astype(str) if v.dtype == object else v      # no pickled object arrays (np.load without pickle)
    out.update(extra or {})
    np.savez(path, **out)


def write_zip(path, comps, which="v11"):
    import zipfile
    with zipfile.ZipFile(path, "w") as zf:
        for i, c in comps.items():
            s = np.asarray(c[which], np.float64)
            assert len(s) == len(c["pid"]) and np.isfinite(s).all(), c["key"]
            zf.writestr(c["zip_name"], "\n".join(f"{p} {v:.6f}" for p, v in zip(c["pid"], -s)) + "\n")
    return path
'''
