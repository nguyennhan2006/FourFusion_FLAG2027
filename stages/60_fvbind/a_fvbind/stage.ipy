print("[cell] a_fvbind 1/5: locate the six input files, build a scratch copy of the original folder layout with the verbatim scripts", flush=True)
# Stage a_fvbind (group 60_fvbind, kind assemble). New driver code; the logic is the verbatim scripts under tree/ (see CHANGES.md).
# It repeats the two commands the team ran on 15/11/2026 at about 08:24 (zip timestamps; see original/SOURCE.json), from the repository root:
#   bash Experiment/EVALPATH-U/make_eval_zip.sh <f1s_eval.zip> <rfsfxfvb_eval.zip> <posteval_FVBIND_U_fvb.zip> eval --counts '<4 files>'
#   ENF_RFS=<rfsfxfvb_eval.zip> ENF_U=<posteval_FVBIND_U_fvb.zip> ENF_OUT=<posteval_FVBIND_ENFUSE_fvb.zip> python Experiment/ENFUSE-U/run.py
# and adds a cross-check: the one-step script release/factor_enfuse/rebuild_final.py must give the same ENFUSE members.
import hashlib, json, os, shutil, subprocess, sys, tempfile, zipfile
from pathlib import Path

IN, OUT = Path("/kaggle/input"), Path("/kaggle/working")
STAGE = Path(os.environ.get("FF_STAGE_DIR") or (Path(os.environ.get("FF_REPO", ".")) / "stages/60_fvbind/a_fvbind"))
assert (STAGE / "tree/Experiment/ENFUSE-U/run.py").is_file(), f"stage folder not found ({STAGE}): the runner sets FF_STAGE_DIR; else set FF_REPO"
MODE = os.environ.get("FF_MODE", "")
STRICT = MODE == "assemble" or os.environ.get("FF_STRICT_SHA") == "1"   # mode (c): inputs are the saved originals -> byte-exact outputs required
COUNTS = ("no_gender/sub_score_v4_English_heard.txt=392,no_gender/sub_score_v4_Bangla_unheard.txt=802,"
          "gender/sub_score_v4_English_heard.txt=416,gender/sub_score_v4_Bangla_unheard.txt=716")
K112 = "notebooks/thanhhuyen11/flag-2027-nb-112f1sx-eval"
K50 = "notebooks/thanhhuyen11/flag-2027-nb-50cc-e2e-eval"
K163 = "notebooks/thanhhuyen11/flag-2027-nb-163i-rfsfxfvb-eval"
SPEC = {  # local name: (kernel artifact, path inside it, sha256 of the file the 15/11 zips were built from)
    "f1s_eval.zip": (K112, "e2e_out/submission_cleantune01_F1_CA_eval.zip", "1b43b14ff763bd0eac72fea505e4cfd4ff98bc41d87d49baecdfd613525a6962"),
    "cleantune01_fuser_bangla_CA.json": (K112, "e2e_out/cleantune01_fuser_bangla_CA.json", "c4737367e787da6dc9a1e08453a9602e2ea60b830bd7a56e8d6728501e9d06a4"),
    "ct01r2_final_eval.npz": (K112, "e2e_out/ct01r2_final_eval.npz", "bbad53ed8e32066240f405676e7f3676dd55040573c00d1fad07b81774c3d0fc"),
    "components_eval.npz": (K50, "e2e_eval/components_eval.npz", "2cd160ae456447c0c47bf611f2f73480ffc5c9161e767812d42e5f380b1b56c7"),
    "e2e_manifest.json": (K50, "e2e_eval/e2e_manifest.json", "b0ba27c2982f917199d957cd42763fecfdd31c292352594a4e141105ce72bd58"),
    "rfsfxfvb_eval.zip": (K163, "FLAG_RF_E2E/submission.zip", "45044189ae4b228b93aaae7e6eb4015f38516bfaa8c57abf2940db7ea6590862"),
}
PLACE = {  # where the team machine had each file, relative to its repository root (the scripts read these paths)
    "f1s_eval.zip": "Experiment/EVALPATH-U/eval_out/f1s_eval.zip",
    "cleantune01_fuser_bangla_CA.json": "Experiment/ENFUSE-U/in/f1/e2e_out/cleantune01_fuser_bangla_CA.json",
    "ct01r2_final_eval.npz": "Experiment/ENFUSE-U/in/f1/e2e_out/ct01r2_final_eval.npz",
    "components_eval.npz": "Experiment/ENFUSE-U/in/c50/e2e_eval/components_eval.npz",
    "e2e_manifest.json": "Experiment/ENFUSE-U/in/c50/e2e_eval/e2e_manifest.json",
    "rfsfxfvb_eval.zip": "Experiment/FVBIND-01/out/rfsfxfvb_eval.zip",
}
SCRIPTS = ("Experiment/EVALPATH-U/make_eval_zip.sh", "Experiment/EVALPATH-U/check_eval_zip.py", "Experiment/XTEAM-03/run.py",
           "Experiment/ENFUSE-U/run.py", "Experiment/E2E/e2e_lib.py", "release/factor_enfuse/rebuild_final.py")


def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def flat_roots():
    """folders of saved score files: $A_FVBIND_INPUTS, then <root>/05_scores for every root of $FF_DATA, then <repo>/assembly/inputs
    (DESIGN 5.3: the place for the saved files in a private copy of the repository)"""
    out = [Path(os.environ["A_FVBIND_INPUTS"])] if os.environ.get("A_FVBIND_INPUTS") else []
    out += [Path(r) / "05_scores" for r in os.environ.get("FF_DATA", "").split(os.pathsep) if r]
    out += [STAGE.resolve().parents[2] / "assembly" / "inputs"]
    return [r for r in out if r.is_dir()]


def find(name):
    k, rel, _ = SPEC[name]
    for p in [IN / k / rel] + [r / name for r in flat_roots()]:
        if p.is_file():
            return p
    hits = sorted(IN.rglob(name)) if IN.is_dir() else []
    if hits:
        return hits[0]
    raise FileNotFoundError(f"{name}: not at {IN / k / rel}, not in a 05_scores or assembly/inputs folder, not anywhere under {IN}")


REPORT = {"stage": "a_fvbind", "mode": MODE, "strict": STRICT, "inputs": {}, "outputs": {}, "checks": {}}
SRC = {}
for name, (k, rel, want) in SPEC.items():
    p = find(name); got = sha256(p); SRC[name] = p
    REPORT["inputs"][name] = {"path": str(p), "sha256": got, "expected": want, "match": got == want}
    print(f"  {name:34s} {'== original' if got == want else '!= original'}  {got[:16]}  <- {p}", flush=True)
bad = [n for n, r in REPORT["inputs"].items() if not r["match"]]
if bad and STRICT:
    raise AssertionError(f"mode {MODE or 'strict'}: inputs differ from the files the original zips were built from: {bad}")

TMP = Path("/kaggle/tmp") if Path("/kaggle/tmp").is_dir() else Path(tempfile.gettempdir())
T = Path(tempfile.mkdtemp(prefix="ff_a_fvbind_", dir=TMP))   # scratch copy of the team machine's repository root
for rel in SCRIPTS:
    (T / rel).parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(STAGE / "tree" / rel, T / rel)
for name, rel in PLACE.items():
    (T / rel).parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SRC[name], T / rel)
(T / "Experiment/FVBIND-01/zips").mkdir(parents=True, exist_ok=True)
(T / "Experiment/POSTEVAL-01").mkdir(parents=True, exist_ok=True)
(T / "Experiment/POSTEVAL-01/manifest.json").write_text(json.dumps({"zips": {}}), encoding="utf-8")   # ENFUSE-U/run.py records ENF_OUT here
(OUT / "logs").mkdir(parents=True, exist_ok=True)
ENV = {**os.environ, "PYTHONIOENCODING": "utf-8", "PYTHONUNBUFFERED": "1",
       "PATH": os.path.dirname(sys.executable) + os.pathsep + os.environ.get("PATH", "")}
for k in ("XT_W", "ENF_W", "ENF_RFS", "ENF_U", "ENF_OUT"):   # XT_W / ENF_W = later optional knobs (15/11 09:33): unset = the 15/11 08:24 build
    ENV.pop(k, None)


def run(cmd, log, env=None, check=True):
    """one step of the original chain, run inside the scratch tree; output streamed line by line and kept in logs/"""
    print("  $", " ".join(cmd), flush=True)
    with open(OUT / "logs" / log, "w", encoding="utf-8") as fl:
        p = subprocess.Popen(cmd, cwd=T, env=env or ENV, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
        for line in p.stdout:
            print("    " + line, end="", flush=True)
            fl.write(line)
        code = p.wait()
    if check and code != 0:
        raise RuntimeError(f"{' '.join(cmd[:2])} failed (exit {code}); log {OUT / 'logs' / log}")
    return code


print("  scratch tree:", T, flush=True)
# <<<FF-CELL>>>
print("[cell] a_fvbind 2/5: zip U = F1s' + RFX' pair by pair (make_eval_zip.sh -> XTEAM-03/run.py), as built on 15/11", flush=True)
run(["bash", "Experiment/EVALPATH-U/make_eval_zip.sh", "Experiment/EVALPATH-U/eval_out/f1s_eval.zip", "Experiment/FVBIND-01/out/rfsfxfvb_eval.zip",
     "Experiment/FVBIND-01/zips/posteval_FVBIND_U_fvb.zip", "eval", "--counts", COUNTS], "make_eval_zip_U.log")
assert (T / "Experiment/FVBIND-01/zips/posteval_FVBIND_U_fvb.zip").is_file()
# <<<FF-CELL>>>
print("[cell] a_fvbind 3/5: zip ENFUSE (ENFUSE-U/run.py): English = F1s' Bangla fuser on the English trials + RFX', Bangla = bytes of zip U", flush=True)
run([sys.executable, "Experiment/ENFUSE-U/run.py"], "enfuse_u.log",
    env={**ENV, "ENF_RFS": "Experiment/FVBIND-01/out/rfsfxfvb_eval.zip", "ENF_U": "Experiment/FVBIND-01/zips/posteval_FVBIND_U_fvb.zip",
         "ENF_OUT": "Experiment/FVBIND-01/zips/posteval_FVBIND_ENFUSE_fvb.zip"})
assert (T / "Experiment/FVBIND-01/zips/posteval_FVBIND_ENFUSE_fvb.zip").is_file()
# <<<FF-CELL>>>
print("[cell] a_fvbind 4/5: cross-check with the one-step script release/factor_enfuse/rebuild_final.py (rfx_eval.zip := rfsfxfvb_eval.zip)", flush=True)
RIN = T / "rebuild_in"
RIN.mkdir(exist_ok=True)
for name in ("f1s_eval.zip", "components_eval.npz", "e2e_manifest.json", "cleantune01_fuser_bangla_CA.json", "ct01r2_final_eval.npz"):
    shutil.copyfile(SRC[name], RIN / name)
shutil.copyfile(SRC["rfsfxfvb_eval.zip"], RIN / "rfx_eval.zip")
code = run([sys.executable, "release/factor_enfuse/rebuild_final.py", str(RIN), str(OUT / "FVBIND_ENFUSE_rebuilt.zip"),
            str(T / "Experiment/FVBIND-01/zips/posteval_FVBIND_ENFUSE_fvb.zip")], "rebuild_final.log", check=False)
REPORT["checks"]["rebuild_final_identical_to_chain"] = code == 0
print("  cross-check:", "rebuild_final.py output identical to the chain output" if code == 0 else
      "rebuild_final.py output DIFFERS from the chain output (the chain zip is the one kept; investigate)", flush=True)
if code != 0 and os.environ.get("FF_STRICT_CROSSCHECK") == "1":
    raise AssertionError("rebuild_final.py cross-check failed (FF_STRICT_CROSSCHECK=1)")
# <<<FF-CELL>>>
print("[cell] a_fvbind 5/5: copy the two zips out, member sha256 against the 15/11 originals (must be identical in mode assemble)", flush=True)
EXPECT = {
    "posteval_FVBIND_U_fvb.zip": {   # zip sha256 b61c84edca2921fc... (zip bytes hold timestamps: members are compared)
        "no_gender/sub_score_v4_English_heard.txt": "578ef595d23150637f95a5da72b30b2af9d557d217de3d549c5ff3b9e6d3aa65",
        "no_gender/sub_score_v4_Bangla_unheard.txt": "1f6e8aea3927185a7460b88bc3adff5737e895b866576cf4c0d6ba6bfd4c9043",
        "gender/sub_score_v4_English_heard.txt": "bed8ac03b742342d338ebbb52214b1e9ddb450ffa90d5cdb385470fe94115a54",
        "gender/sub_score_v4_Bangla_unheard.txt": "9a6197360fa2c1ddb8c7039730df67b3ace221a635a10abfe51f3ec72c38f392"},
    "posteval_FVBIND_ENFUSE_fvb.zip": {   # zip sha256 bb0e0175e9e94481... (Evaluation submission 8)
        "no_gender/sub_score_v4_English_heard.txt": "eb1ef21098092e75012a8c130e489563e9d23eb7757b38eff271dc0c3017cb3e",
        "no_gender/sub_score_v4_Bangla_unheard.txt": "1f6e8aea3927185a7460b88bc3adff5737e895b866576cf4c0d6ba6bfd4c9043",
        "gender/sub_score_v4_English_heard.txt": "7f016f444d0d35035e99d13058d16e9d87f063894c3f4ee17dd9090049881a48",
        "gender/sub_score_v4_Bangla_unheard.txt": "9a6197360fa2c1ddb8c7039730df67b3ace221a635a10abfe51f3ec72c38f392"},
}
KEY = ("posteval_FVBIND_ENFUSE_fvb.zip", "gender/sub_score_v4_Bangla_unheard.txt")   # the member the final 13.54 zip carries unchanged
for z, members in EXPECT.items():
    shutil.copyfile(T / "Experiment/FVBIND-01/zips" / z, OUT / z)
    with zipfile.ZipFile(OUT / z) as f:
        got = {n: hashlib.sha256(f.read(n)).hexdigest() for n in f.namelist()}
    assert sorted(got) == sorted(members), (z, sorted(got))
    REPORT["outputs"][z] = {"zip_sha256": sha256(OUT / z),
                            "members": {n: {"sha256": got[n], "expected": e, "match": got[n] == e} for n, e in members.items()}}
    for n, e in members.items():
        print(f"  {z:32s} {n:44s} {'== original' if got[n] == e else '!= original'}  {got[n][:16]}", flush=True)
for f in sorted((T / "Experiment/ENFUSE-U/out").glob("*.txt")):
    shutil.copyfile(f, OUT / "logs" / f.name)
shutil.copyfile(T / "Experiment/POSTEVAL-01/manifest.json", OUT / "logs/POSTEVAL-01_manifest_scratch.json")
key_ok = REPORT["outputs"][KEY[0]]["members"][KEY[1]]["match"]
REPORT["checks"]["gender_bangla_member_equals_the_1354_file"] = key_ok
(OUT / "a_fvbind_report.json").write_text(json.dumps(REPORT, indent=1), encoding="utf-8")
print(f"  member {KEY[1]} of {KEY[0]}:", "== 9a6197360fa2c1dd... (byte-exact file of the 13.54 zip)" if key_ok else
      "differs (expected when the GPU stages were re-run; final_verify compares Spearman)", flush=True)
if STRICT:
    miss = [(z, n) for z, r in REPORT["outputs"].items() for n, m in r["members"].items() if not m["match"]]
    assert not miss, f"mode {MODE or 'strict'}: members differ from the originals: {miss}"
shutil.rmtree(T, ignore_errors=True)
print("  outputs:", sorted(p.name for p in OUT.iterdir()), flush=True)
# <<<FF-CELL>>>
