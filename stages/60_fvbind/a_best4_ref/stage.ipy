print("[cell] a_best4_ref 1/2: locate posteval_FACTOR_ENFUSE_c5rl.zip (stage a_factor) and posteval_FVBIND_ENFUSE_fvb.zip (stage a_fvbind)", flush=True)
# Stage a_best4_ref (group 60_fvbind, optional reference, kind assemble). New code replacing `python Experiment/EVALPROBE-01/make_probes.py final`,
# which loads about 25 zips at import; only the two zips BEST_NOW picks are needed. BEST4 (16.72 = mean of the four measured cell EERs:
# FACTOR_ENFUSE ng/En, ng/Bn, g/En and FVBIND ENFUSE g/Bn (CodaBench 1053013); never submitted as such) is NOT an input of the 13.54 zip: final_blend reads the two ENFUSE zips directly. This stage only re-creates the reference.
import hashlib, json, os, zipfile
from pathlib import Path
import numpy as np

IN, OUT = Path("/kaggle/input"), Path("/kaggle/working")
MODE = os.environ.get("FF_MODE", "")
STRICT = MODE == "assemble" or os.environ.get("FF_STRICT_SHA") == "1"
CELLS = {"ngEn": "no_gender/sub_score_v4_English_heard.txt", "ngBn": "no_gender/sub_score_v4_Bangla_unheard.txt",
         "gEn": "gender/sub_score_v4_English_heard.txt", "gBn": "gender/sub_score_v4_Bangla_unheard.txt"}      # make_probes.py:15-18
BEST_NOW = {"ngEn": "FACTOR_ENFUSE", "ngBn": "FACTOR_ENFUSE", "gEn": "FACTOR_ENFUSE", "gBn": "FVBIND_ENFUSE"}     # make_probes.py:112
WANT = {"FACTOR_ENFUSE": ("notebooks/ff/a_factor", "posteval_FACTOR_ENFUSE_c5rl.zip", "9cf5bbe4e3af14184c26eef08104d3ddd94fc5357569c09fc657a93d4549fd93"),
        "FVBIND_ENFUSE": ("notebooks/ff/a_fvbind", "posteval_FVBIND_ENFUSE_fvb.zip", "bb0e0175e9e9448128a529db8ed537cec0eef427d044729f030c4984830b0bbc")}


def find(kernel, name):
    roots = [Path(r) / "05_scores" for r in os.environ.get("FF_DATA", "").split(os.pathsep) if r]
    if os.environ.get("FF_STAGE_DIR"):        # <repo>/assembly/inputs (DESIGN 5.3, private copy of the repository)
        roots.append(Path(os.environ["FF_STAGE_DIR"]).resolve().parents[2] / "assembly" / "inputs")
    for p in [IN / kernel / name] + [r / name for r in roots]:
        if p.is_file():
            return p
    hits = sorted(IN.rglob(name)) if IN.is_dir() else []
    if hits:
        return hits[0]
    raise FileNotFoundError(f"{name}: not at {IN / kernel / name}, not in a 05_scores or assembly/inputs folder, not under {IN}")


P = {}
for k, (kernel, name, zsha) in WANT.items():
    P[k] = find(kernel, name)
    print(f"  {k}: {P[k]}  (zip sha256 {hashlib.sha256(P[k].read_bytes()).hexdigest()[:16]}; the 15/11 zip: {zsha[:16]}, "
          f"zip bytes hold timestamps, so only members are compared)", flush=True)
# <<<FF-CELL>>>
print("[cell] a_best4_ref 2/2: write fourfusion_BEST4_v1.zip as make_probes.py write_zip(BEST_NOW) does; member sha256", flush=True)


def load(path):   # = make_probes.py load()
    z = zipfile.ZipFile(path); d = {}
    for s, c in CELLS.items():
        t = z.read(c).decode().split()
        d[s] = (t[0::2], np.array(t[1::2], dtype=float))
    return d


DATA = {k: load(p) for k, p in P.items()}
ORDER = {s: DATA["FACTOR_ENFUSE"][s][0] for s in CELLS}   # make_probes.py: pair order of FACTOR_ENFUSE


def vec(name, s):   # = make_probes.py vec()
    ids, v = DATA[name][s]
    m = dict(zip(ids, v))
    return np.array([m[k] for k in ORDER[s]])


out = OUT / "fourfusion_BEST4_v1.zip"
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:   # = make_probes.py write_zip()
    for s, c in CELLS.items():
        v = vec(BEST_NOW[s], s)
        assert np.isfinite(v).all() and len(v) == len(ORDER[s])
        z.writestr(c, "".join(f"{k} {x:.8f}\n" for k, x in zip(ORDER[s], v)))
EXPECT = {"no_gender/sub_score_v4_English_heard.txt": "44e2781f5673e318318c7662a2cc4feb28f347557db8288a18cbe2cbac5af69c",
          "no_gender/sub_score_v4_Bangla_unheard.txt": "36056e7e8d9764ad16535e0d158f849a45e238180f8360df46105c654739f703",
          "gender/sub_score_v4_English_heard.txt": "73e485fd8803a2f897974257f77bb45c6319d9f8466ca6fd067af2f48e6964db",
          "gender/sub_score_v4_Bangla_unheard.txt": "9a6197360fa2c1ddb8c7039730df67b3ace221a635a10abfe51f3ec72c38f392"}
REP = {"stage": "a_best4_ref", "mode": MODE, "zip": str(out), "members": {}}
with zipfile.ZipFile(out) as z:
    for s, c in CELLS.items():
        b = z.read(c); h = hashlib.sha256(b).hexdigest()
        same_src = b == zipfile.ZipFile(P[BEST_NOW[s]]).read(c)   # %.8f in, %.8f out: the member equals its source member byte for byte
        REP["members"][c] = {"source": BEST_NOW[s], "sha256": h, "expected": EXPECT[c], "match": h == EXPECT[c], "equals_source_member": same_src}
        print(f"  {c:44s} from {BEST_NOW[s]:13s} {'== original' if h == EXPECT[c] else '!= original'}  {h[:16]}  same bytes as source: {same_src}", flush=True)
(OUT / "a_best4_ref_report.json").write_text(json.dumps(REP, indent=1), encoding="utf-8")
if STRICT:
    assert all(m["match"] for m in REP["members"].values()), "mode assemble: BEST4 members differ from the 15/11 reference"
# <<<FF-CELL>>>
