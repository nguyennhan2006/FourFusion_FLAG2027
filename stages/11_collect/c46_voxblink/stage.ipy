FF_HF_REV = lambda repo: __import__("json").loads(__import__("os").environ.get("FF_HF_REVS") or "{}").get(repo, "main")
class FF_PartURL(str):   # [FF pin] the VoxBlink mirror is one HF repo per part: each part gets its own revision
    def format(self, part, *rest):
        return str.format(self.replace("/main", "/" + FF_HF_REV(f"adollahamini1998/VoxBlink-Video-clean-8-{part}"), 1), part, *rest)
RES = "https://huggingface.co/datasets/adollahamini1998/ScriptsForVoxBlinkResources/resolve/" + FF_HF_REV("adollahamini1998/ScriptsForVoxBlinkResources") + "/"
PROG = "https://huggingface.co/datasets/adollahamini1998/VoxBlinkProgressVideos/resolve/" + FF_HF_REV("adollahamini1998/VoxBlinkProgressVideos") + "/progress/download_progress_clean_8_{}.json"
TREE = FF_PartURL("https://huggingface.co/api/datasets/adollahamini1998/VoxBlink-Video-clean-8-{}/tree/main")
SHARD = FF_PartURL("https://huggingface.co/datasets/adollahamini1998/VoxBlink-Video-clean-8-{}/resolve/main/{}")
