# <<<FF-CELL>>>
# insightface --no-deps: its declared deps would pull CPU onnxruntime over onnxruntime-gpu (as FLAG_04).
# ImageBind / CLIP --no-deps: their pins (torch 1.13, pytorchvideo) would break Kaggle's torch; flag_models only needs
# the model code, and reimplements the two data loaders it uses.
if not LOCAL:
    !pip -q install onnxruntime-gpu onnx iopath ftfy omegaconf fvcore 2>&1 | tail -2
    # FF environment patch (CHANGES.md #4): one pip call per package, the team's own fix of 29/10 - 2/11/2026 (BEST/v1977/README.md
    # §6): openai CLIP's setup.py needs pkg_resources, missing on the current Kaggle image, and a failed build in this shared call also
    # drops insightface / ImageBind. CLIP then comes from a git clone at d50d76d with that one import line patched (FaRL needs `clip`).
    !pip -q install --no-deps "insightface==2.0" "git+https://github.com/facebookresearch/ImageBind" 2>&1 | tail -2
    !pip -q install --no-deps "git+https://github.com/openai/CLIP.git" 2>&1 | tail -2
    try:
        import clip
    except ModuleNotFoundError:
        import subprocess
        _oc = Path("/tmp/openai_clip")
        if not (_oc / "clip").exists():
            subprocess.run(["git", "clone", "-q", "https://github.com/openai/CLIP.git", str(_oc)], check=True)
            subprocess.run(["git", "-C", str(_oc), "checkout", "-q", "d50d76daa670286dd6cacf3bcd80b5e4823fc8e1"], check=True)
            _f = _oc / "clip/clip.py"
            _f.write_text(_f.read_text().replace("from pkg_resources import packaging", "import packaging, packaging.version"))
        sys.path.insert(0, str(_oc))
        import clip
import numpy as np, pandas as pd, torch, json, time, transformers
print("torch", torch.__version__, "| transformers", transformers.__version__, "| cuda", torch.cuda.is_available(),
      torch.cuda.get_device_name(0) if torch.cuda.is_available() else "")
# <<<FF-CELL>>>
# --- FF reproduction patch (stage f10_models, CHANGES.md #1): edit two helper modules written by the cell above BEFORE they
# --- are imported. (a) ImageBind: Meta's link is dead since 12/11/2026 -> the same file (sha256 d6f6c22b...2157) on a pinned
# --- Hugging Face mirror (the dead URL is spelled in two parts so that a text-level URL patch cannot alter this edit).
# --- (b) Hugging Face revisions pinned (the runs of 27-28/09/2026 resolved "main").
def _ff_edit(path, edits):
    t = Path(path).read_text(encoding="utf-8")
    for _old, _new in edits:
        assert t.count(_old) == 1, f"FF patch: {path}: {_old[:70]!r} found {t.count(_old)} times"
        t = t.replace(_old, _new)
    Path(path).write_text(t, encoding="utf-8")


_ff_edit("flag_models.py", [
    ('URL = "https://dl.fbaipublicfiles' + '.com/imagebind/imagebind_huge.pth"',
     'URL = "https://huggingface.co/PKU-Alignment/AnyRewardModel/resolve/40c7e2ade237848a194b2b77517da024c4ec8532/imagebind/imagebind_huge.pth"'),
    ('ViTImageProcessor.from_pretrained(self.ID)', 'ViTImageProcessor.from_pretrained(self.ID, revision="4b5acc345d9692c3ff4f45d250531afd3a3da0ef")'),
    ('ViTForImageClassification.from_pretrained(self.ID)',
     'ViTForImageClassification.from_pretrained(self.ID, revision="4b5acc345d9692c3ff4f45d250531afd3a3da0ef")'),
    ('path = snapshot_download(self.ID)', 'path = snapshot_download(self.ID, revision="54f602a0737bd1ee4a4e7e9fd089a485f397fefd")'),
])
_ff_edit("agegender.py", [
    ('proc = Wav2Vec2Processor.from_pretrained(name)', 'proc = Wav2Vec2Processor.from_pretrained(name, revision="bad2737f529168bc3d3fcd97edfaba9583c7d36d")'),
    ('model = AgeGenderModel.from_pretrained(name)', 'model = AgeGenderModel.from_pretrained(name, revision="bad2737f529168bc3d3fcd97edfaba9583c7d36d")'),
])
import flag_extract as X, flag_models as M
OUT = WORKDIR / "feats_models"; OUT.mkdir(exist_ok=True)
FACE = list(M.FACE_ENCODERS)             # vitage farl siglip2 adaface ibv
VOICE = list(M.VOICE_ENCODERS)           # w2v2ag iba   (order: ImageBind vision then audio share one load)
ORDER = [e for e in FACE if e != "ibv"] + ["w2v2ag", "ibv", "iba"]
# ONE walk over /kaggle/input that skips faces/ and voices/ folders: an extracted v1/v2 holds hundreds of thousands
# of files, and every rglob over it costs minutes. Everything below looks things up in SCAN instead.
SCAN = M.scan_inputs(IN)
# --- FF dev-exclusion (CHANGES.md #2): index ONLY the organiser train list. Original line:
# ---     S = M.v4_index(SCAN, WORKDIR / "raw")
# --- v4_index needs the four dev lists too and, for zipped data, unpacks dev_set.zip. Same train rows and order as there:
# --- flag_extract.resolve_split on train_English.txt (what flag_extract.index_splits does for "train").
_ff_tr = [p for p in SCAN["files"].get("train_English.txt", []) if M._has_media(p, 2, 3)]
if _ff_tr:
    _ff_root = _ff_tr[0].parent
else:
    import zipfile as _ff_zip
    _ff_root = WORKDIR / "raw"
    _ff_root.mkdir(parents=True, exist_ok=True)
    _ff_zips = [p for n, ps in SCAN["files"].items() if n.lower().startswith("train_set") and n.lower().endswith(".zip") for p in ps]
    assert _ff_zips, "no v4 train media under the inputs: attach the raw dataset (train_set.zip)"
    for _zp in _ff_zips:
        if not (_ff_root / f".{_zp.stem}.done").exists():
            X.log("extracting", _zp.name)
            with _ff_zip.ZipFile(_zp) as _z:
                _z.extractall(_ff_root)
            (_ff_root / f".{_zp.stem}.done").touch()
S = {"train": X.resolve_split(_ff_root, "train_English.txt", 2, 3)}
for _k, _v in S.items():
    _v["dur"] = np.array([X.sf.info(str(_v["root"] / p)).duration for p in _v["wav"]], dtype=np.float32)
    X.log(f"{_k:20s} {len(_v['wav']):5d} rows | dur median {np.median(_v['dur']):.1f}s max {_v['dur'].max():.1f}s")
meta = SCAN["files"].get("meta_file_train_set.csv")
assert meta, "meta_file_train_set.csv (train gender labels) not found in the inputs: attach the raw v4 dataset"
X.copy_metadata(meta[0].parent, S, OUT)

# MAV-Celeb v1/v2 validation rows (optional): the archive/folder + the existing meta csv that fixes the row order.
# Several copies (capped feats_ext vs feats_ext_full) -> take the largest: it is the superset, joined on `path` later.
EXT = {}
for name in ["v1_complete", "v2_complete"]:
    metas = sorted(SCAN["files"].get(f"ext_{name}_voice_meta.csv", []), key=lambda p: -p.stat().st_size)
    src = M.ext_source(SCAN, name)
    if metas and src is not None:
        try:
            print(f"{name}: rows from {metas[0].parent}")
            EXT[name] = M.ExtRows(src, name, metas[0].parent)
        except Exception as e:                    # optional source: a bad zip / missing row must not stop the run
            print(f"{name}: skipped, cannot read its rows from {src} ({type(e).__name__}: {e})")
    else:
        print(f"{name}: skipped (meta csv found: {bool(metas)}, source found: {src is not None})")
print("v4 rows per split:", {k: len(v["wav"]) for k, v in S.items()}, "| external:", list(EXT))

# Resume: attach an earlier version's output (flag2027-feats-models) and its arrays are copied here, so only the
# encoders still missing run (e.g. after an encoder failed). Nothing to copy on a first run.
SEEDED = M.seed_from_previous(SCAN, OUT, ORDER)
# <<<FF-CELL>>>
CHECKS, FAILED = {}, {}
face_probe = [S["train"]["root"] / p for p in S["train"]["jpg"][:6]]
voice_probe = [X.load_audio(S["train"]["root"] / p) for p in S["train"]["wav"][:4]]   # FF dev-exclusion (CHANGES.md #3): original read S["no_gender/Bangla"] (dev); these 4 clips only feed the fp16 self-check
for name in ORDER:
    kind = "face" if name in FACE else "voice"
    t0 = time.time()
    if M.done(name, kind, S, EXT, OUT):
        print(f"== {name}: every array already exists -> skipped (not even loaded)")
        continue
    try:
        enc = M.build(name, CACHE)
        CHECKS[name] = M.check_face(enc, face_probe) if kind == "face" else M.check_voice(enc, voice_probe)
        print(name, "checks:", CHECKS[name])
        assert min(CHECKS[name].values()) > 0.995, f"{name}: batching / fp16 changes the embedding {CHECKS[name]}"
        M.extract_v4(name, enc, S, OUT, kind)
        for src_name, rows in EXT.items():
            M.extract_ext(name, enc, rows, src_name, OUT, kind)
    except Exception as e:                        # an optional encoder must not kill the run
        FAILED[name] = f"{type(e).__name__}: {e}"
        print(f"!! {name} FAILED -> skipped: {FAILED[name]}")
    enc = None
    if name != "ibv":                              # keep ImageBind loaded for the audio pass right after
        M.release()
    print(f"== {name} done in {time.time() - t0:.0f}s")
print("failed:", FAILED or "none")
# <<<FF-CELL>>>
tr = pd.read_csv(OUT / "index_train.txt", sep=" ", header=None)
spk = tr[4].values
gmap = dict(pd.read_csv(OUT / "meta_file_train_set.csv", header=None).values)
P, SANITY = M.probe(OUT, spk, gmap, seeds=(1,) if LOCAL else (1, 2, 3), n=200 if LOCAL else 3000)
P.to_csv(OUT / "probe.csv", index=False)
print(P.to_string(index=False))
print(json.dumps(SANITY, indent=1))
# Reading guide (train, true labels, no training):
#  identity rows  - adaface should be near ArcFace (~2 % ng); a stream near 50 % is broken, not "attribute-rich".
#  ImageBind rows - zero-shot face<->voice. PLAN_V4: near chance (>= ~45 %) -> stop the ImageBind line, no LoRA.
#                   For scale: the trained bridge (VGG + BTC, internal) is ~22 / ~30 (ng / g) at sample level.
#  sanity         - w2v2 gender agreement should be > 0.9 (the 'gender' cells cannot use it; age is what matters there).
