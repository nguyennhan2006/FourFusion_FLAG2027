print("[cell] a7", flush=True)
# ============================================================================ running
def run_faces_tensor(enc, srcs, bs=64, label=""):
    out, t0 = {}, time.time()
    for s in range(0, len(srcs), bs):
        x = torch.stack([enc.prep(read_rgb(p() if callable(p) else p)) for p in srcs[s:s + bs]])
        for k, v in enc(x).items():
            out.setdefault(k, []).append(v)
        if (s // bs) % 40 == 0:
            log(f"  {label} {s + len(x)}/{len(srcs)}  {time.time() - t0:.0f}s")
    return {k: np.concatenate(v).astype(np.float32) for k, v in out.items()}


def run_voices_single(enc, n, load, label=""):
    """One file at a time: no padding enters a mean."""
    out, t0 = {}, time.time()
    for i in range(n):
        for k, v in enc(load(i)).items():
            out.setdefault(k, []).append(np.atleast_1d(v))
        if i % 1000 == 0 or i == n - 1:
            el = time.time() - t0
            log(f"  {label} {i + 1}/{n}  {el:.0f}s  eta {el / (i + 1) * (n - i - 1):.0f}s")
    return {k: np.stack(v).astype(np.float32) for k, v in out.items()}


# output names: {kind}_{array}_{split}.npy for organiser splits, ext_{src}_{kind}_{array}.npy for v1/v2
ARRAYS = {"arcface": ("face", {"": "arcface", "_detok": "arcface_detok"}),
          "ecapa": ("voice", {"192": "ecapa192", "6144": "ecapa6144"}),
          "vitage": ("face", {"": "vitage", "prob": "vitageprob"}),
          "w2v2ag": ("voice", {"": "w2v2ag", "age": "w2v2agage", "gen": "w2v2aggen"}),
          "ibv": ("face", {"": "ibv"}), "iba": ("voice", {"": "iba"})}
MAIN = {"arcface": "", "ecapa": "192", "vitage": "", "w2v2ag": "", "ibv": "", "iba": ""}
ARRAYS.update(ARRAYS_NEW); MAIN.update(MAIN_NEW)                         # this notebook's arrays


def _dt(v, split):
    """float16 for the v1/v2 rows (as FLAG_12) and for every wide array (layers / tokens); float32 otherwise."""
    return v if (split and v.ndim == 2 and v.shape[1] <= 4096) or v.ndim == 1 else v.astype(np.float16)


def target(name, suffix, split=None, src=None):
    kind, names = ARRAYS[name]
    return OUT / (f"{kind}_{names[suffix]}_{tag(split)}.npy" if split else f"ext_{src}_{kind}_{names[suffix]}.npy")


def complete(name, split=None, src=None):
    return all(target(name, s, split, src).exists() for s in ARRAYS[name][1])


def save(name, R, split=None, src=None):
    for s, v in R.items():                         # main array last: its presence marks the job as done
        if s != MAIN[name]:
            np.save(target(name, s, split, src), _dt(v, split))
    np.save(target(name, MAIN[name], split, src), _dt(R[MAIN[name]], split))


def extract(name, enc, split=None, src=None):
    kind = ARRAYS[name][0]
    if split:
        sp = S[split]
        faces = [sp["root"] / p for p in sp["jpg"]]
        load = lambda i: load_audio(sp["root"] / sp["wav"][i])
        n, durs, label = len(sp["wav"]), sp["dur"], split
    else:
        rows = EXT[src]
        faces = [rows.read(p) for p in rows.face] if name == "arcface" else [(lambda p=p: rows.read(p)) for p in rows.face]
        load = lambda i: centre_crop(load_audio(io.BytesIO(rows.read(rows.voice[i]))), rows.L)
        n, label = len(rows.voice), src
        durs = np.full(n, 12.0, np.float32)          # upper bound after the crop: batches stay within budget
    if kind == "face":
        R = enc.embed(faces, label=label) if name == "arcface" else run_faces_tensor(enc, faces, label=f"{name} {label}")
    elif name == "ecapa":
        R = enc.embed(load, n, durs, label=label)
    else:
        R = run_voices_single(enc, n, load, label=f"{name} {label}")
    save(name, R, split, src)
    log(f"saved {target(name, MAIN[name], split, src).name} {R[MAIN[name]].shape}")


def self_check(name, enc):
    """Batching / fp16 must not change the embeddings (min cosine over a few rows; must be > 0.995)."""
    k = next(k for k in S if k != "train") if len(S) > 1 else next(iter(S))
    sp = S[k]
    if name == "arcface":
        return {}
    if name == "ecapa":
        idx = list(np.argsort(-sp["dur"])[:3]) + list(range(min(5, len(sp["wav"]))))
        sigs = [load_audio(sp["root"] / sp["wav"][i]) for i in idx]
        b, s = enc.batch(sigs), [enc.batch([x])[0] for x in sigs]
        return {"batch192": float(cos_rows([r[0] for r in b], [r[0] for r in s]).min()),
                "batch6144": float(cos_rows([r[1] for r in b], [r[1] for r in s]).min())}
    if ARRAYS[name][0] == "face":
        x = torch.stack([enc.prep(read_rgb(sp["root"] / p)) for p in sp["jpg"][:6]])
        full = enc(x, use_amp=False)[""]
        single = np.concatenate([enc(x[i:i + 1], use_amp=False)[""] for i in range(len(x))])
        return {"batch": float(cos_rows(full, single).min()), "fp16": float(cos_rows(full, enc(x)[""]).min())}
    waves = [load_audio(sp["root"] / p) for p in sp["wav"][:3]]
    return {"fp16": float(cos_rows([enc(w, use_amp=False)[""] for w in waves], [enc(w)[""] for w in waves]).min())}


CHECKS, FAILED = {}, {}
for name in ENCODERS:
    jobs = [("split", k) for k in S if not complete(name, split=k)]
    if name in EXT_ENCODERS:
        jobs += [("src", s) for s in EXT if not complete(name, src=s)]
    if not jobs:
        log(f"== {name}: every array already exists -> skipped")
        continue
    t0 = time.time()
    try:
        enc = build(name)
        CHECKS[name] = self_check(name, enc)
        log(name, "self-check:", CHECKS[name])
        assert not CHECKS[name] or min(CHECKS[name].values()) > 0.995, f"{name}: batching / fp16 changes the output"
        for what, key in jobs:
            try:
                extract(name, enc, **({"split": key} if what == "split" else {"src": key}))
            except Exception as e:                  # one bad source must not cost the other splits
                FAILED[f"{name}:{key}"] = f"{type(e).__name__}: {e}"
                log(f"!! {name} on {key} FAILED: {FAILED[f'{name}:{key}']}")
    except Exception as e:
        FAILED[name] = f"{type(e).__name__}: {e}"
        log(f"!! {name} FAILED -> skipped: {FAILED[name]}")
    enc = None
    release(keep_ib=(name in ('ibv',)))
    log(f"== {name} done in {time.time() - t0:.0f}s")
print("failed:", FAILED or "none")
# <<<FF-CELL>>>
print("[cell] a8", flush=True)
# ============================================================================ zero-shot probe on TRUE labels (no training)
# v4 train: positives = two rows of the same person (v4 has no video id, so some may share a session);
# MAV-Celeb v1/v2: positives = face and voice of the same person from DIFFERENT videos. The dev lists are never used.
from sklearn.metrics import roc_curve


def eer(s, y):
    fpr, tpr, _ = roc_curve(y, s); fnr = 1 - tpr; i = np.nanargmin(np.abs(fnr - fpr)); return 100 * (fpr[i] + fnr[i]) / 2


l2n = lambda X: X / (np.linalg.norm(X, axis=-1, keepdims=True) + 1e-8)


def load_arr(stem, kind, split=None, src=None):
    f = OUT / (f"{kind}_{stem}_{tag(split)}.npy" if split else f"ext_{src}_{kind}_{stem}.npy")
    return np.load(f).astype(np.float32) if f.exists() else None


def probe_pairs(n=3000, seed=0):
    """-> list of (data, protocol, face rows, voice rows, labels, split, src)."""
    rng, out = np.random.RandomState(seed), []
    if "train" in S:
        nr = len(S["train"]["wav"])
        spk = pd.read_csv(S["train"]["txt"], sep=" ", header=None)[4].astype(str).values[:nr]
        meta = SCAN["files"].get("meta_file_train_set.csv")
        gmap = dict(pd.read_csv(meta[0], header=None).values) if meta else {}
        by = {s: np.where(spk == s)[0] for s in np.unique(spk)}
        ok = [i for i in range(nr) if len(by[spk[i]]) > 1]
        if ok:
            pos = [(i, rng.choice(by[spk[i]][by[spk[i]] != i])) for i in rng.choice(ok, n)]
            for sg in (False, True):
                neg, tries = [], 0
                while len(neg) < n and tries < 100 * n:
                    i, j = rng.randint(nr, size=2); tries += 1
                    if spk[i] != spk[j] and (not sg or (gmap.get(spk[i]) == gmap.get(spk[j]) and spk[i] in gmap)):
                        neg.append((i, j))
                pr = np.array(pos + neg)
                out.append(("v4 train", "g" if sg else "ng", pr[:, 0], pr[:, 1], np.r_[np.ones(len(pos)), np.zeros(len(neg))],
                            "train", None))
    for s, rws in EXT.items():
        md = SCAN["files"][f"ext_{s}_voice_meta.csv"][0].parent
        fm = pd.read_csv(md / f"ext_{s}_face_meta.csv").iloc[:len(rws.face)].reset_index(drop=True)
        vm = pd.read_csv(md / f"ext_{s}_voice_meta.csv").iloc[:len(rws.voice)].reset_index(drop=True)
        vidx = rng.choice(len(vm), min(n, len(vm)), replace=False)
        pos, neg = [], []
        for vi in vidx:
            r = vm.iloc[vi]
            cand = np.where((fm.spk.values == r.spk) & (fm.video.values != r.video))[0]
            if len(cand):
                pos.append((rng.choice(cand), vi))
            other = np.where(fm.spk.values != r.spk)[0]
            if len(other):
                neg.append((rng.choice(other), vi))
        if not pos or not neg:
            continue
        pr = np.array(pos + neg); y = np.r_[np.ones(len(pos)), np.zeros(len(neg))]
        for lang in sorted(vm.lang.unique()):
            m = vm.lang.values[pr[:, 1]] == lang
            if m.sum() and len(np.unique(y[m])) == 2:
                out.append((f"{s} cross-video", f"ng {lang}", pr[m, 0], pr[m, 1], y[m], None, s))
    return out


def run_probe(scorers, name="probe_zeroshot.csv"):
    """scorers: {label: fn(split, src, face rows, voice rows) -> scores or None}."""
    rows = []
    for data_, prot, fi, vi, y, split, src in probe_pairs():
        for lab, fn in scorers.items():
            try:
                s = fn(split, src, fi, vi)
            except Exception as e:
                log(f"probe {lab} on {data_}: {type(e).__name__}: {e}"); s = None
            if s is not None:
                rows.append(dict(data=data_, protocol=prot, model=lab, n=len(y), eer=round(eer(s, y), 2)))
    PR = pd.DataFrame(rows)
    if len(PR):
        PR.to_csv(OUT / name, index=False)
        print(PR.pivot_table(index="model", columns=["data", "protocol"], values="eer").round(2).to_string())
    else:
        print("probe: nothing to score (arrays missing, or no same-person pairs among these rows)")
    return PR

# Per-layer VOICE <-> VOICE identity probe on v4 train (no face involved): EER of cosine between two clips of the same
# person vs two different persons of the same gender. It shows where speaker identity sits in each model; the face <->
# voice test runs locally (LAYER-ID-01).
rows = []
if "train" in S:
    nr = len(S["train"]["wav"])
    spk = pd.read_csv(S["train"]["txt"], sep=" ", header=None)[4].astype(str).values[:nr]
    meta = SCAN["files"].get("meta_file_train_set.csv")
    gmap = dict(pd.read_csv(meta[0], header=None).values) if meta else {}
    rng = np.random.RandomState(0)
    by = {s: np.where(spk == s)[0] for s in np.unique(spk)}
    ok = [i for i in range(nr) if len(by[spk[i]]) > 1]
    pos = [(i, rng.choice(by[spk[i]][by[spk[i]] != i])) for i in rng.choice(ok, 3000)] if ok else []
    neg, tries = [], 0
    while len(neg) < 3000 and tries < 300000:
        i, j = rng.randint(nr, size=2); tries += 1
        if spk[i] != spk[j] and gmap.get(spk[i]) == gmap.get(spk[j]) and spk[i] in gmap:
            neg.append((i, j))
    if pos and neg:
        pr = np.array(pos + neg); y = np.r_[np.ones(len(pos)), np.zeros(len(neg))]
        for k in ("whv3",):
            A = load_arr(k, "voice", split="train")
            if A is None:
                continue
            shp = RESHAPE.get(f"voice_{k}", [1, A.shape[1]])
            A = l2n(A.reshape(len(A), *shp))
            for l in range(shp[0]):
                rows.append(dict(model=k, layer=l, eer_same_gender=round(eer(np.sum(A[pr[:, 0], l] * A[pr[:, 1], l], -1), y), 2)))
LP = pd.DataFrame(rows)
if len(LP):
    LP.to_csv(OUT / "probe_layers_voice_identity.csv", index=False)
    print(LP.pivot_table(index="layer", columns="model", values="eer_same_gender").round(2).to_string())
# <<<FF-CELL>>>
print("[cell] a9", flush=True)
man = {"created": time.strftime("%Y-%m-%d %H:%M"), "splits": {k: len(v["wav"]) for k, v in S.items()},
       "external": {k: [len(r.face), len(r.voice)] for k, r in EXT.items()}, "encoders": ENCODERS,
       "checks": CHECKS, "failed": FAILED, "audio": AUDIO_STATS, "broken": BROKEN, "resumed_arrays": len(SEEDED),
       "versions": {"torch": torch.__version__, "transformers": transformers.__version__},
       "files": {f.name: list(np.load(f, mmap_mode="r").shape) for f in sorted(OUT.glob("*.npy"))}}
try:
    import speechbrain, insightface
    man["versions"].update(speechbrain=speechbrain.__version__, insightface=insightface.__version__)
except Exception:
    pass
man["reshape"] = RESHAPE                 # flattened wide arrays: row -> (L, D)
(OUT / "feats_manifest.json").write_text(json.dumps(man, indent=1))
shutil.rmtree(WORKDIR / "raw", ignore_errors=True)
tot = sum(p.stat().st_size for p in OUT.glob("*")) / 1e9
print(f"{len(man['files'])} arrays, {tot:.2f} GB in {OUT} | failed: {FAILED or 'none'}")
print("NEXT: Save Version (Save & Run All) -> Output -> New Dataset -> name it flag2027-feats-whv3-a (re-run with this output attached until every encoder is done)")
# <<<FF-CELL>>>
print("[cell] upload", flush=True)
UPL = os.environ.get("WH_UPLOAD", "")
(OUT / "whisper01_meta.json").write_text(json.dumps(dict(repo=WH_REPO, revision=WH_REV, mode=WH_MODE, dim=1280, dtype="float16",
        recipe="first 30 s, encoder last_hidden_state, mean of the first n frames, n=max(1,min(1500,ceil(len/16000/30*1500)))",
        rows="a: split / ext arrays in the FLAG_12 order; b, c: <vox|vox2b|vb>/voice_whv3.npy in voice_meta.csv order, NaN = not in this lane (b = even chunks, c = odd chunks of the cache list)",
        unreadable_file="a: framework stand-in (1 s of silence), listed in feats_manifest.json broken")))
if UPL and os.environ.get("FLAG_SMOKE") != "1":
    try:
        import kagglehub
        kagglehub.dataset_upload(UPL, str(OUT), version_notes=f"WHISPER-01 whv3 lane {WH_MODE}")
        print("uploaded ->", UPL, flush=True)
    except Exception as e:
        print(f"upload to {UPL} failed ({e!r}); the arrays are in the notebook output", flush=True)
print("ALL CELLS OK", flush=True)
