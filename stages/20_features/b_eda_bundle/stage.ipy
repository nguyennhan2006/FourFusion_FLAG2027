print("[cell] b_eda_bundle 1/3: helpers and input artifacts", flush=True)
# NEW cell (FourFusion reproduction repository, stage b_eda_bundle; DESIGN.md §4.5). The original step was a script run on the
# team's machine (kaggle/build_eda_bundle.py, 29/09/2026 08:06) over the local folders kaggle_upload/train and kaggle/output/feats_*.
# This stage rebuilds that folder layout from the input artifacts, runs the script (verbatim except the changes in CHANGES.md) and
# unpacks its zip: the unpacked folder is the content of the Kaggle dataset ngnnguynchn/flag2027-eda-bundle-p (Kaggle unpacks an
# uploaded zip; package E: holds a re-download of it).
import os, sys, json, shutil, subprocess, zipfile, zlib, hashlib, time
from pathlib import Path

KIN = Path("/kaggle/input")        # the runner points this at the stage's own input view
KOUT = Path("/kaggle/working")     # ... and this at the stage's own working directory
STAGE_DIR = Path(os.environ.get("FF_STAGE_DIR", "."))
SCRIPT = STAGE_DIR / "build_eda_bundle.py"
assert SCRIPT.is_file(), f"FF_STAGE_DIR must be the folder stages/20_features/b_eda_bundle of the repository (missing {SCRIPT})"


def art_root(aid):
    """Mounted folder of an input artifact: <input>/<artifact id>; else the same slug under another owner; else <input>/<slug>."""
    kind, owner, slug = aid.split("/")
    for p in [KIN / aid] + sorted((KIN / kind).glob(f"*/{slug}")) + [KIN / slug]:
        if p.is_dir():
            return p
    raise FileNotFoundError(f"input artifact {aid} is not mounted under {KIN}")


def find_dir(root, *markers):
    """The folder under `root` (root included) holding every marker file; the shallowest one when there are several."""
    hits = [Path(dp) for dp, dns, fns in os.walk(root, followlinks=True) if all(m in fns for m in markers)]
    assert hits, f"no folder under {root} holds {markers}"
    return sorted(hits, key=lambda p: (len(p.parts), str(p)))[0]


def find_file(root, name):
    hits = [Path(dp) / name for dp, dns, fns in os.walk(root, followlinks=True) if name in fns]
    return sorted(hits, key=lambda p: (len(p.parts), str(p)))[0] if hits else None


R = KOUT / "_ff_repo"              # stand-in for the team's repository root (the script resolves every path from it)
shutil.rmtree(R, ignore_errors=True)
LINKS = []


def link_dir(dst, src):
    """dst -> src as a folder symlink; a copy where symlinks are not allowed (e.g. Windows without developer mode)."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.symlink(src, dst, target_is_directory=True)
    except OSError:
        shutil.copytree(src, dst)
    LINKS.append(dst)

RAW = art_root("datasets/ngnnguynchn/flag2027-raw-v4-p")
FX = find_dir(art_root("notebooks/ff/r08_mav_rows"), "ext_v1_complete_face.npy", "ext_v1_complete_face_meta.csv", "ext_v2_complete_voice.npy")
FM = find_dir(art_root("notebooks/ff/f10_models"), "face_ibv_train.npy", "face_vitageprob_train.npy", "face_farl_train.npy")
FE = find_dir(art_root("notebooks/ff/f12_eval_feats"), "face_arcface_train.npy", "voice_ecapa192_train.npy", "ext_v1_complete_face_arcface.npy")
for k, v in (("raw v4", RAW), ("feats_ext_full (r08)", FX), ("feats_models (f10)", FM), ("feats_eval (f12)", FE)):
    print(f"{k:22s} {v}", flush=True)
# <<<FF-CELL>>>
print("[cell] b_eda_bundle 2/3: rebuild the repository layout and run kaggle/build_eda_bundle.py", flush=True)
# kaggle_upload/train = the organisers' train csv / txt (members of train_set.zip) + meta_file_train_set.csv: the files of the team's
# copy (CRC32 of each equals the CRC32 stored in train_set.zip; checked on the team's copies 18/11/2026).
UP = R / "kaggle_upload/train"
UP.mkdir(parents=True)
WANT = {"train_English_faces.csv": ("train_set/features/faces/train_English_faces.csv", 0xC6B3BC03),
        "train_English_voices.csv": ("train_set/features/voices/train_English_voices.csv", 0x0F15A6E5),
        "train_English.txt": ("train_set/train_set/train_English.txt", 0x0860A460)}
zp = find_file(RAW, "train_set.zip")
for name, (member, crc) in WANT.items():
    if zp is not None:
        with zipfile.ZipFile(zp) as z:
            b = z.read(member)
    else:                                            # organiser data attached already unpacked
        f = find_file(RAW, name)
        assert f is not None, f"{name}: neither train_set.zip nor an unpacked copy under {RAW}"
        b = f.read_bytes()
    assert zlib.crc32(b) == crc, f"{name}: CRC32 {zlib.crc32(b):#010x} != {crc:#010x} (not the organisers' train_set)"
    (UP / name).write_bytes(b)
meta = find_file(RAW, "meta_file_train_set.csv")
assert meta is not None and zlib.crc32(meta.read_bytes()) == 0x0535112A, "meta_file_train_set.csv missing or not the organisers' file"
shutil.copy(meta, UP / "meta_file_train_set.csv")
link_dir(R / "kaggle/output/feats_ext_full", FX)
link_dir(R / "kaggle/output/feats_models", FM)
link_dir(R / "kaggle/output/feats_eval", FE)
# FF wiring (CHANGES.md): the script reads the v4 ArcFace / ECAPA-192 arrays from kaggle/output/feats_v2 (FLAG_04). FLAG_12 wrote the
# same bytes for these train arrays (sha256 55491b54... / b3bd0a64..., checked 18/11/2026), so feats_v2 points at the feats_eval folder.
link_dir(R / "kaggle/output/feats_v2", FE)
# FF wiring (CHANGES.md): FF_EDA_CREATED = the original bundle's stamp. Six notebooks of the chain assert
# eda_bundle_manifest.json "created" == lab_manifest.json "eda_bundle_created" ("2026-09-29 08:06", written by build_lab_bundle.py).
env = {**os.environ, "FF_REPO_ROOT": str(R), "FF_EDA_CREATED": "2026-09-29 08:06", "PYTHONUNBUFFERED": "1"}
subprocess.run([sys.executable, "-u", str(SCRIPT)], env=env, check=True)
# <<<FF-CELL>>>
print("[cell] b_eda_bundle 3/3: unpack the bundle (= the dataset content), compare, clean up", flush=True)
ZIP = R / "kaggle/flag2027-eda-bundle.zip"
DS = KOUT / "eda_bundle_dataset"
shutil.rmtree(DS, ignore_errors=True)
with zipfile.ZipFile(ZIP) as z:
    z.extractall(DS)
    members = {i.filename: {"bytes": i.file_size} for i in z.infolist() if not i.is_dir()}
for name in members:
    members[name]["sha256"] = hashlib.sha256((DS / name).read_bytes()).hexdigest()
rep = {"stage": "b_eda_bundle", "dataset": "ngnnguynchn/flag2027-eda-bundle-p", "created": time.strftime("%Y-%m-%d %H:%M"), "zip_bytes": ZIP.stat().st_size,
       "members": members}
exp_f = STAGE_DIR / "expected_members.json"
if exp_f.is_file():                 # the original dataset, file by file (package E:); byte identity expected only for frozen inputs
    exp = json.loads(exp_f.read_text(encoding="utf-8"))["members"]
    same = sorted(n for n in members if n in exp and exp[n]["sha256"] == members[n]["sha256"])
    diff = sorted(n for n in members if n in exp and exp[n]["sha256"] != members[n]["sha256"])
    rep["vs_original"] = {"identical": len(same), "differ": diff, "missing": sorted(set(exp) - set(members)),
                          "extra": sorted(set(members) - set(exp))}
    print("vs the original dataset:", json.dumps({k: (v if k == "identical" else v[:12]) for k, v in rep["vs_original"].items()}), flush=True)
for p in LINKS:                     # remove the folder links first: never delete the input artifacts they point at
    if os.path.islink(p):
        os.unlink(p)
    else:
        shutil.rmtree(p)
shutil.rmtree(R)
(KOUT / "bundle_report.json").write_text(json.dumps(rep, indent=1))
print(f"{len(members)} files in {DS} = the content of dataset ngnnguynchn/flag2027-eda-bundle-p", flush=True)
# <<<FF-CELL>>>
