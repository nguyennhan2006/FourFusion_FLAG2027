print("[cell] l_groups: language groups (DSEL-01, SCALE-CC-01) and genders of the VoxCeleb2 speakers", flush=True)
# New cell (FourFusion reproduction repo). Runs the two original local scripts (copied into this folder; only their paths are
# parameters, see CHANGES.md) on the FLAG_42 output (VoxLingua107 probabilities of the FLAG_37 clips), the FLAG_53 output
# (flag2027-feats-vox2b-p) and VoxCeleb2's official vox2_meta.csv, then compares the three JSON files with the ones the system used.
import hashlib, json, os, subprocess, sys
from pathlib import Path

STAGE_DIR = Path(os.environ.get("FF_STAGE_DIR", "."))
L42 = Path("/kaggle/input/notebooks/nguynlcnhtho/flag-2027-nb-42")
VB2 = Path("/kaggle/input/datasets/ngnnguynchn/flag2027-feats-vox2b-p")
META = Path("/kaggle/input/raw/voxceleb2_vox2_meta")
OUT = Path("/kaggle/working/groups")
OUT.mkdir(parents=True, exist_ok=True)


def guard_action():
    """stage.json guard_policy.on_mismatch[FF_MODE] ('warn' | 'fail'); FF_SMOKE=1 or FF_ALLOW_MISMATCH=1 -> 'warn'.
    In FF_MODE=train FLAG_42 may have been rerun (VoxLingua107 on GPU is not bit-identical)."""
    if os.environ.get("FF_SMOKE") == "1" or os.environ.get("FF_ALLOW_MISMATCH") == "1":
        return "warn", "FF_SMOKE=1 or FF_ALLOW_MISMATCH=1"
    mode = os.environ.get("FF_MODE", "")
    try:
        pol = json.loads((STAGE_DIR / "stage.json").read_text(encoding="utf-8"))["guard_policy"]["on_mismatch"]
    except Exception:
        pol = {"train": "warn"}
    return pol.get(mode, "fail"), f"stage.json guard_policy.on_mismatch[{mode or 'FF_MODE unset'}]"


def one(root, name, why):
    hits = sorted(p for p in root.rglob(name) if p.is_file())
    assert hits, f"{name} not found under {root} ({why})"
    return hits[0]


env = dict(os.environ,
           FF_VOX2LID=str(one(L42, "voice_lid_probs.npy", "FLAG_42 output feats_vox2lid").parent),
           FF_FLAG53_DIR=str(one(VB2, "voice_lid_probs.npy", "FLAG_53 output feats_vox2b").parent),
           FF_FLAG42_LABELS=str(one(L42, "lid_labels.json", "FLAG_42 output feats_vox2lid")),
           FF_VOX2_META=str(one(META, "vox2_meta.csv", "VoxCeleb2 official vox2_meta.csv")),
           FF_DSEL01_SCRIPT=str(STAGE_DIR / "dsel01_make_groups.py"), FF_OUT=str(OUT))
for script in ("dsel01_make_groups.py", "scalecc01_make_groups.py"):
    cmd = [sys.executable, "-u", str(STAGE_DIR / script)]
    print("run:", " ".join(cmd), flush=True)
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1, env=env)
    for line in p.stdout:
        print(line, end="", flush=True)
    assert p.wait() == 0, f"{script} failed"

# The originals were written on Windows (Path.write_text: CRLF line ends); compare the content with the line ends normalised.
EXPECTED = {"vox2_groups.json": "4f44f5cee3f9a3ae1109962158c07dcb0101a2a3bdd7c99cf27ed787c7a35cc6",
            "vox2b_groups.json": "7beb7ce7f67de74bcc753e1d8f2be10560b105d74dbcbf220c493d65d27fc742",
            "vox2_gender.json": "1d229fddee02f573f598497d833d1b9b28619cff53501024bd8d3dec50768089"}
rep = {}
for n, d in EXPECTED.items():
    b = (OUT / n).read_bytes()
    crlf = b if b"\r\n" in b else b.replace(b"\n", b"\r\n")
    rep[n] = {"sha256": hashlib.sha256(b).hexdigest(), "sha256_crlf": hashlib.sha256(crlf).hexdigest(),
              "same_as_original": hashlib.sha256(crlf).hexdigest() == d}
bad = [n for n, r in rep.items() if not r["same_as_original"]]
action, why = ("pass", "all equal") if not bad else guard_action()
rep["guard"] = {"action": action, "why": why, "FF_MODE": os.environ.get("FF_MODE", "")}
(OUT / "l_groups_check.json").write_text(json.dumps(rep, indent=1))
print(json.dumps(rep, indent=1), flush=True)
if action == "warn":
    print(f"!! WARNING: {bad} differ from the files the system used ({why})", flush=True)
assert action != "fail", (
    f"{bad} differ from the files the system used (FLAG_42 rerun, or a pandas version ordering tied language counts differently); "
    "use the stored FLAG_42 output or set FF_ALLOW_MISMATCH=1 to keep them (" + why + ")")
# <<<FF-CELL>>>
print("[cell] l_groups: South-Asian VoxCeleb2 speakers (VBSEL-01 vox2_sa_speakers.json)", flush=True)
# New cell (FourFusion reproduction repo, 19/11/2026). Rebuilds Experiment/VBSEL-01/vox2_sa_speakers.json, the frozen list that the
# F-family stages carry in their embedded code (VBSEL-01/run.py line 20), from the FLAG_42 output (VoxLingua107 probabilities of the
# FLAG_37 VoxCeleb2 clips). Rule = Experiment/EDA-VB/eda_vb.py section (4), the computation that produced the file on 10/10/2026:
#   top-1 VoxLingua107 code of each clip; share of a speaker's clips whose code is South-Asian (hi ur pa ta te mr gu ne si ml kn);
#   keep share >= 0.5; remove the Bengali-flagged speakers of the FLAG_42 rule (lid_summary.json speakers_dropped_ids).
# The file is written as the original was (json indent 0, Windows line ends) and compared by sha256 with the embedded copy.
import hashlib, json, os
from pathlib import Path
import numpy as np, pandas as pd

L42 = Path(os.environ.get("FF_VBSEL_L42", "/kaggle/input/notebooks/nguynlcnhtho/flag-2027-nb-42"))
OUT = Path(os.environ.get("FF_VBSEL_OUT", "/kaggle/working/groups"))
OUT.mkdir(parents=True, exist_ok=True)
SA = ["hi", "ur", "pa", "ta", "te", "mr", "gu", "ne", "si", "ml", "kn"]
EMBEDDED_SHA256 = "eccc765365323b2ea52a97822b17eb33ffaa4dc46e0aca00f85f2df1911dd278"   # configs/data_map.json (CRLF form)
DEFINITION = ("VoxCeleb2 speakers (FLAG_37 key list) with >= 50 % of their clips whose VoxLingua107 top-1 language is one of "
              "hi,ur,pa,ta,te,mr,gu,ne,si,ml,kn; Bengali-flagged speakers (FLAG_42 rule) removed. Frozen 10/10 before VBSEL-01 ran "
              "(EDA-VB E3).")

probs = sorted(p for p in L42.rglob("voice_lid_probs.npy") if p.is_file())
assert probs, f"voice_lid_probs.npy not found under {L42} (FLAG_42 output feats_vox2lid)"
LD = probs[0].parent
meta = pd.read_csv(LD / "voice_meta.csv", dtype={"video": str})          # FLAG_37 clip rows, same order as voice_lid_probs.npy
labels = json.loads((LD / "lid_labels.json").read_text())
P = np.load(LD / "voice_lid_probs.npy")
dropped = set(json.loads((LD / "lid_summary.json").read_text())["speakers_dropped_ids"])
assert len(meta) == len(P), (len(meta), P.shape)
codes = np.array([str(l).split(":")[0].strip() for l in labels])
top = codes[P.argmax(1)]
share = pd.Series(np.isin(top, SA)).groupby(meta.spk.values[: len(top)]).mean()
speakers = sorted(set(share.index[share >= .5]) - dropped)
text = json.dumps({"definition": DEFINITION, "languages": SA, "speakers": speakers}, indent=0)
(OUT / "vox2_sa_speakers.json").write_bytes(text.replace("\n", "\r\n").encode("utf-8"))
sha = hashlib.sha256((OUT / "vox2_sa_speakers.json").read_bytes()).hexdigest()
rep = {"clips": int(len(top)), "speakers_scored": int(len(share)), "bengali_flagged_removed": int(len(dropped & set(share.index[share >= .5]))),
       "speakers": len(speakers), "sha256_crlf": sha, "same_as_embedded": sha == EMBEDDED_SHA256}
print(json.dumps(rep, indent=1), flush=True)
if not rep["same_as_embedded"]:
    action, why = guard_action() if "guard_action" in globals() else ("fail", "no guard policy")
    rep["guard"] = {"action": action, "why": why, "FF_MODE": os.environ.get("FF_MODE", "")}
    print(f"!! vox2_sa_speakers.json differs from the embedded copy ({why})", flush=True)
    assert action != "fail", ("vox2_sa_speakers.json differs from the copy the F-family stages embed (FLAG_42 rerun?); use the stored "
                              "FLAG_42 output or set FF_ALLOW_MISMATCH=1 (" + why + ")")
(OUT / "vbsel_check.json").write_text(json.dumps(rep, indent=1))
# <<<FF-CELL>>>
