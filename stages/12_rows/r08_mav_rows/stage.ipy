# <<<FF-CELL>>>
print("[cell] r08 guard: MAV input layout and POSIX path order (new cell, changes nothing)", flush=True)
# New cell (FourFusion reproduction repo), inserted before the original extraction cell. The row tables ext_*_meta.csv are fully
# determined by the file listing, so three things must hold exactly as in the original Kaggle run:
#  1. POSIX path order: flag_extract.DirArchive lists files with sorted(Path.rglob("*")); pathlib sorts case-SENSITIVELY on Linux and
#     case-insensitively on Windows -> another voice row order (the original ran on Kaggle, Linux).
#  2. no zip of a MAV release under /kaggle/input: find_attached_source() returns an attached zip before the extracted folder; a zip
#     gives member names with the 'v1/' prefix and zip order instead of the sorted folder listing -> other path column and row order.
#  3. exactly the two extracted roots .../mavceleb_v1_complete-001/v1 and .../mavceleb_v2_complete-002/v2, and no '/v1/' or '/v2/'
#     segment above the mount point (find_attached_source matches the root by the '/v1/' / '/v2/' text of its path).
import os, re
from pathlib import Path

_IN = Path("/kaggle/input")
assert os.name == "posix" or os.environ.get("FF_ALLOW_NONPOSIX") == "1", (
    "r08_mav_rows must run on Linux (Kaggle / Docker): pathlib sorts paths case-insensitively on Windows, which changes the voice "
    "row order of ext_*_voice_meta.csv. Set FF_ALLOW_NONPOSIX=1 only for a smoke test.")
_zips, _roots = [], []
for _dp, _dn, _fn in os.walk(_IN, followlinks=True):
    if "faces" in _dn and "voices" in _dn:
        _roots.append(Path(_dp))
    _dn[:] = [d for d in _dn if d not in ("faces", "voices")]          # do not walk the 700 000 media files
    _zips += [Path(_dp) / f for f in _fn if f.lower().endswith(".zip")
              and re.search(r"v1_complete|v2_complete|v3_tran|v3_train", f.lower().replace("-", "_"))]
assert not _zips, (f"zip(s) of a MAV-Celeb release under /kaggle/input: {[str(z) for z in _zips]}. Mount only the EXTRACTED dataset "
                   "datasets/chnnhnnguyn/external-data-mavceleb (stage raw_mavceleb), never the zips.")
_roots = sorted(_roots)
print("MAV roots:", [str(r) for r in _roots], flush=True)
assert len(_roots) == 2 and _roots[0].as_posix().endswith("mavceleb_v1_complete-001/v1") \
    and _roots[1].as_posix().endswith("mavceleb_v2_complete-002/v2"), "expected exactly .../mavceleb_v1_complete-001/v1 and .../mavceleb_v2_complete-002/v2"
for _p in (_IN, _IN.resolve()):
    assert not re.search(r"/v[12]/", _p.as_posix().lower().replace("-", "_") + "/"), \
        f"the mount point path {_p} contains a /v1/ or /v2/ segment: find_attached_source would match the wrong root"
print("guard OK", flush=True)
# <<<FF-CELL>>>
print("[cell] r08: optional local copy of the VGG-Face weights (new cell; .pth checked by sha256, .py still from the original link)", flush=True)
# New cell (FourFusion reproduction repo). The original cell (flag_extract.VGGFace) downloads vgg_face_dag.py (the network
# definition, exec'd) and vgg_face_dag.pth (the weights) from www.robots.ox.ac.uk/~albanie/models/pytorch-mcn/ into
# WORKDIR/_vggface, each only when absent. This cell pre-seeds the weights from a local copy when one with the known sha256 exists:
#   $FLAG_CACHE/vgg_face_dag.pth            (the runner seeds FLAG_CACHE from FF_DATA/06_pretrained/cache/flag = tools/fetch_models.py dest)
#   FF_DATA/06_pretrained/cache/flag/vgg_face_dag.pth   FF_DATA/06_pretrained/rfs_models/vgg_face.pt (same file, fetch_models also_as)
#   FF_DATA/06_pretrained/vgg_face_dag/vgg_face_dag.pth (older layout)
# vgg_face_dag.py is copied only when its sha256 is recorded (VGG_PY_SHA256; not measured yet: stage.json todo); otherwise the
# original code downloads it (a few kB). Numbers are unchanged: the weights are the same file, checked by sha256.
import hashlib, os, shutil
from pathlib import Path

VGG_PTH_SHA256 = "f070b241e3faf17a08c78f8700d334413230bac5de7fbcfd01b3cf05ce10de1a"   # 580 015 466 bytes (E: package + RFS cache)
VGG_PY_SHA256 = None                                                                     # todo: record from a first download


def _sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 22), b""):
            h.update(b)
    return h.hexdigest()


_roots = [Path(d) for d in os.environ.get("FF_DATA", "").split(os.pathsep) if d]
_pth = ([Path(os.environ["FLAG_CACHE"]) / "vgg_face_dag.pth"] if os.environ.get("FLAG_CACHE") else []) \
    + [r / "06_pretrained" / rel for r in _roots for rel in ("cache/flag/vgg_face_dag.pth", "rfs_models/vgg_face.pt",
                                                              "vgg_face_dag/vgg_face_dag.pth")] \
    + ([Path(os.environ["FF_MODELS"]) / "cache/flag/vgg_face_dag.pth"] if os.environ.get("FF_MODELS", "auto") not in ("auto", "off") else [])
_dst = WORKDIR / "_vggface"
if (_dst / "vgg_face_dag.pth").exists():
    print("VGG-Face weights already in", _dst, flush=True)
else:
    for _c in _pth:
        if not _c.is_file():
            continue
        if _sha256(_c) != VGG_PTH_SHA256:
            print("!! ignored (another sha256):", _c, flush=True)
            continue
        _dst.mkdir(parents=True, exist_ok=True)
        shutil.copy2(_c, _dst / "vgg_face_dag.pth")
        print("VGG-Face weights copied from", _c, flush=True)
        _py = _c.parent / "vgg_face_dag.py"
        if VGG_PY_SHA256 and _py.is_file() and _sha256(_py) == VGG_PY_SHA256 and not (_dst / "vgg_face_dag.py").exists():
            shutil.copy2(_py, _dst / "vgg_face_dag.py")
            print("vgg_face_dag.py copied from", _py, flush=True)
        break
    else:
        print("no local VGG-Face weights: the original cell downloads them from www.robots.ox.ac.uk", flush=True)
if not (_dst / "vgg_face_dag.py").exists():
    print("vgg_face_dag.py: downloaded by the original cell from www.robots.ox.ac.uk (no recorded sha256 for a local copy)", flush=True)
# <<<FF-CELL>>>
print("[cell] r08 smoke: with FF_SMOKE=1 process only a few MAV speakers (new cell; does nothing otherwise)", flush=True)
# New cell (FourFusion reproduction repo), before the original extraction cell. A full run lists ~714 000 MAV files and encodes
# 40 271 wav + 16 533 frames (about 9-10 h on a T4), far beyond a CPU smoke session. With FF_SMOKE=1 this cell arranges that, when
# the extraction cell imports the flag_extract module written by cell 2, two of its functions are replaced right after the import:
#   find_attached_source(IN, name) -> the v1 / v2 root found by the guard cell (no rglob over the whole input tree);
#   open_archive(folder)           -> a DirArchive over the first FF_R08_SMOKE_SPEAKERS speakers (default 2) and the first
#                                     FF_R08_SMOKE_VIDEOS videos (default 2) of each speaker / language, faces and voices.
# The patch is applied by an import hook, so the module (and torch) are still imported after the original `!pip install` line.
# Everything else (pip install, encoders, batching, the meta / array writers) runs as in the original. The tables then differ from
# ngnnguynchn/flag2027-ext-meta-p by design: smoke_env sets FF_R08_ALLOW_MISMATCH=1 so the verify cell only warns.
import os, sys
from pathlib import Path

if os.environ.get("FF_SMOKE") == "1":
    import importlib.abc, importlib.machinery
    _NS = int(os.environ.get("FF_R08_SMOKE_SPEAKERS", "2"))
    _NV = int(os.environ.get("FF_R08_SMOKE_VIDEOS", "2"))
    _MAVROOTS = {"v1_complete": _roots[0], "v2_complete": _roots[1]}          # _roots: sorted v1 / v2 roots of the guard cell

    def _smoke_patch(X):
        class _SmokeArchive(X.DirArchive):
            def __init__(self, root):
                self.root = Path(root)
                files = []
                for kind in ("faces", "voices"):
                    for spk in sorted(p for p in (self.root / kind).iterdir() if p.is_dir())[:_NS]:
                        for lang in sorted(p for p in spk.iterdir() if p.is_dir()):
                            for vid in sorted(p for p in lang.iterdir() if p.is_dir())[:_NV]:
                                files += [p for p in vid.iterdir() if p.is_file()]
                self._infos = [self._Info(self.root, p) for p in sorted(files)]
                self._by = {i.filename: i for i in self._infos}

        _orig_open_archive = X.open_archive
        X.find_attached_source = lambda inp, name: _MAVROOTS.get(name)
        X.open_archive = lambda path: _SmokeArchive(path) if Path(path).is_dir() else _orig_open_archive(path)
        print(f"SMOKE: flag_extract patched: {_NS} speakers x {_NV} videos per language from",
              {k: str(v) for k, v in _MAVROOTS.items()}, flush=True)

    class _SmokeHook(importlib.abc.MetaPathFinder):
        def find_spec(self, name, path, target=None):
            if name != "flag_extract":
                return None
            sys.meta_path.remove(self)
            spec = importlib.machinery.PathFinder.find_spec(name, path)
            _exec = spec.loader.exec_module

            def exec_module(module):
                _exec(module)
                _smoke_patch(module)
            spec.loader.exec_module = exec_module
            return spec

    if "flag_extract" in sys.modules:
        _smoke_patch(sys.modules["flag_extract"])
    else:
        sys.meta_path.insert(0, _SmokeHook())
        print("SMOKE: flag_extract will be patched when the extraction cell imports it", flush=True)
else:
    print("not a smoke run: the original extraction runs on the full MAV-Celeb v1 / v2 trees", flush=True)
# <<<FF-CELL>>>
if not LOCAL:
    !pip -q install -U "speechbrain>=1.1.1" 2>&1 | tail -2
import shutil, time, numpy as np, pandas as pd, torch
import flag_extract as X
OUTX = WORKDIR / "feats_ext"; OUTX.mkdir(exist_ok=True)
TMP = Path(os.environ.get("FLAG_TMP", "/tmp/flag_ext")); TMP.mkdir(parents=True, exist_ok=True)
print("free disk at", TMP, round(shutil.disk_usage(TMP).free / 1e9, 1), "GB")
ve = X.OrganiserVoice(WORKDIR / "_ecapa_btc")
fe = X.VGGFace(WORKDIR / "_vggface")
# Google Drive "Quota exceeded": open the organiser's link in a browser, "Make a copy" into your own Drive,
# share it as "Anyone with the link", and paste the NEW file id here, e.g. {"v2_complete": "1AbC..."}.
# The mirror is tried first, the organiser's id second.
DRIVE_IDS = {}
SOURCES = {"mini_v3": None} if LOCAL else {k: ([DRIVE_IDS[k], fid] if k in DRIVE_IDS else fid, gb)
                                           for k, (fid, gb) in X.EXT_SOURCES.items()
                                           if k != "v3_train"}   # FF repo: MAV-Celeb v3 is not used by the 13.54 chain (original: also v3_train, downloaded from Google Drive first)
for name, spec in SOURCES.items():
    if (OUTX / f"ext_{name}_voice.npy").exists() and (OUTX / f"ext_{name}_face.npy").exists():
        print("skip (exists)", name); continue
    t0 = time.time()
    try:
        attached = None if LOCAL else X.find_attached_source(IN, name)
        if LOCAL:
            zp = Path(os.environ["FLAG_EXT_MINI"])
        elif attached is not None:                       # uploaded as a Kaggle dataset: no Drive download
            zp = attached
            print(f"{name}: using attached {zp}")
        else:
            fid, gb = spec
            zp = X.fetch_zip(fid, TMP / f"{name}.zip", min_free_gb=gb * 1.2 + 2)
        X.write_speaker_meta(zp, name, OUTX)
        X.extract_external(zp, name, OUTX, ve, fe, frames_per_video=8)
    except (AssertionError, RuntimeError, OSError) as e:        # Drive quota / disk: skip this source, keep going
        print(f"SKIPPED {name}: {type(e).__name__}: {e}")
        continue
    if not LOCAL and (TMP / f"{name}.zip").exists():
        (TMP / f"{name}.zip").unlink()                         # only after a successful extraction
    print(f"{name}: {time.time() - t0:.0f}s", flush=True)
del ve, fe; torch.cuda.empty_cache()
X.write_manifest(OUTX, dict(sources=list(SOURCES), encoders="organiser VGGFace fc7 + yangwang825/ecapa-tdnn-vox2"))
# <<<FF-CELL>>>
print("[cell] r08 verify: row tables byte-identical to ngnnguynchn/flag2027-ext-meta-p (new cell)", flush=True)
# New cell (FourFusion reproduction repo), after the original extraction cell. The four meta tables (+ the v1 speaker table) depend
# only on the file listing, so they must be byte-identical to the tables the whole system was keyed on. The arrays are GPU output
# (VGG-Face fc7 fp16, ECAPA fp32): only their shapes are checked here; their sha256 on the team machine is in stage.json for reference.
import hashlib, json, os
import numpy as np

EXPECTED_META = {
    "ext_v1_complete_face_meta.csv": "7b385161cfb9bcf998110b4f969c7268aaddb8c5567482d2888cc617f92601ae",
    "ext_v1_complete_voice_meta.csv": "3fac359f6a5b4fcab53032296c063fdf3adb73ba587a5107507c67982164635e",
    "ext_v2_complete_face_meta.csv": "9db02bfc517ddf5ea5e52d0c54d937d0887d87038ad969b24172c86a37534c23",
    "ext_v2_complete_voice_meta.csv": "1e22f7667044afe9bbcfa228d66ab4931f76a5df239ecc905e2bc31fa766378b",
    "ext_v1_complete_speakers.csv": "46da520173c773a66f9a9910e2d82d31a20b31db7d675a67532f87ea2b1dd4d9",
}
EXPECTED_SHAPES = {"ext_v1_complete_voice.npy": [19556, 192], "ext_v1_complete_face.npy": [7580, 4096],
                   "ext_v2_complete_voice.npy": [20715, 192], "ext_v2_complete_face.npy": [8953, 4096]}
_rep = {"meta": {}, "shapes": {}}
for _n, _d in EXPECTED_META.items():
    _p = OUTX / _n
    _h = hashlib.sha256(_p.read_bytes()).hexdigest() if _p.exists() else None
    _rep["meta"][_n] = {"sha256": _h, "ok": _h == _d}
for _n, _s in EXPECTED_SHAPES.items():
    _p = OUTX / _n
    _g = list(np.load(_p, mmap_mode="r").shape) if _p.exists() else None
    _rep["shapes"][_n] = {"shape": _g, "ok": _g == _s}
_rep["ok"] = all(v["ok"] for v in _rep["meta"].values()) and all(v["ok"] for v in _rep["shapes"].values())
(WORKDIR / "ff_r08_check.json").write_text(json.dumps(_rep, indent=1))
print(json.dumps(_rep, indent=1), flush=True)
if not _rep["ok"]:
    _msg = "r08: the MAV row tables differ from ngnnguynchn/flag2027-ext-meta-p (see ff_r08_check.json)"
    assert os.environ.get("FF_R08_ALLOW_MISMATCH") == "1", _msg + "; set FF_R08_ALLOW_MISMATCH=1 to keep them anyway"
    print("WARNING:", _msg, flush=True)
# <<<FF-CELL>>>
