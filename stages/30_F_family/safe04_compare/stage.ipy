print("[cell] safe04_compare 1/2: locate the rebuilt (safe04_lab) and the frozen e2e-dev bundles", flush=True)
# NEW stage of the FourFusion reproduction repository: compares the SAFE-04 reference tables rebuilt by safe04_lab with the frozen
# bundle kaggle/flag2027-e2e-dev.zip (= datasets/ngnnguynchn/flag2027-e2e-dev-p; zip sha256 0257b1fe...). Hard checks (the stage fails
# after writing its report when one fails): 37 110 pairs, identical pair keys (fold, data, protocol, y, pf, pv, fi, vi), identical
# stack02_rows (fold, data, y, fp, vp), identical fold_persons.json. Reported, not enforced: max |diff| and Pearson r of every numeric
# column (pf_m / pv_m are expected to agree to float precision; trained columns of the full level are recipe-level only, GPU / BLAS).
import os, json, hashlib, io
from pathlib import Path
import numpy as np, pandas as pd
IN, OUT = Path("/kaggle/input"), Path("/kaggle/working")


def bundles():
    out = {}
    for m in sorted(IN.rglob("e2e_manifest.json")):
        if json.loads(m.read_text()).get("kind") == "e2e-dev":
            out["rebuilt" if (m.parent / "SAFE04_REBUILT.json").exists() else "frozen"] = m.parent
    return out


B = bundles()
print({k: str(v) for k, v in B.items()}, flush=True)
assert "frozen" in B, "attach the frozen bundle (artifact datasets/ff-frozen/flag2027-e2e-dev-p)"
REP = {"stage": "safe04_compare", "frozen": str(B["frozen"]), "rebuilt": str(B.get("rebuilt")), "tables": {}, "hard": {}}
# <<<FF-CELL>>>
print("[cell] safe04_compare 2/2: table by table comparison -> safe04_compare.json / .txt", flush=True)
KEYS = ["fold", "data", "protocol", "y", "pf", "pv", "fi", "vi"]
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
if "rebuilt" not in B:
    REP["status"] = "not-a-rebuild: the e2e-dev input resolved to the frozen copy (safe04_lab did not run in this session); nothing to compare"
else:
    R, F = B["rebuilt"] / "safe04", B["frozen"] / "safe04"
    REP["safe04_lab"] = json.loads((B["rebuilt"] / "SAFE04_REBUILT.json").read_text())
    n_pairs, keys_ok = 0, True
    partial = REP["safe04_lab"].get("complete") is False              # smoke rebuild of safe04_lab (fewer folds): reported, not enforced
    for f in sorted(F.glob("*.parquet")):
        if not (R / f.name).exists():
            REP["tables"][f.name] = {"rows": None, "columns": {}, "sha256_equal": False, "missing": "not rebuilt (smoke / partial)"}
            continue
        a, b = pd.read_parquet(f), pd.read_parquet(R / f.name)
        t = {"rows": [len(b), len(a)], "same_columns": list(a.columns) == list(b.columns), "sha256_equal": sha(f) == sha(R / f.name), "columns": {}}
        for c in a.columns:
            if c not in b.columns:
                t["columns"][c] = "missing in rebuilt"; continue
            x, y = a[c].values, b[c].values
            if c in KEYS or c in ("fp", "vp") or x.dtype.kind in "OUS":
                eq = bool(len(x) == len(y) and (pd.Series(x).astype(str).values == pd.Series(y).astype(str).values).all())
                t["columns"][c] = "identical" if eq else "DIFFERENT"
                if c in KEYS and not eq:
                    keys_ok = False
            else:
                x, y = x.astype(np.float64), y.astype(np.float64)
                nan_same = bool((np.isnan(x) == np.isnan(y)).all()) if len(x) == len(y) else False
                ok = ~(np.isnan(x) | np.isnan(y))
                r = float(np.corrcoef(x[ok], y[ok])[0, 1]) if ok.sum() > 2 and x[ok].std() > 0 and y[ok].std() > 0 else None
                t["columns"][c] = {"max_abs_diff": float(np.max(np.abs(x[ok] - y[ok]))) if ok.any() else None, "pearson_r": r, "nan_pattern_same": nan_same}
        if f.name.startswith("streams_fold"):
            n_pairs += len(b)
        REP["tables"][f.name] = t
    fa, fb = json.loads((F / "fold_persons.json").read_text()), json.loads((R / "fold_persons.json").read_text())
    s2a, s2b = pd.read_parquet(F / "stack02_rows.parquet"), pd.read_parquet(R / "stack02_rows.parquet")
    REP["hard"] = {"pairs_37110": n_pairs == 37110, "pair_keys_identical": keys_ok,
                   "stack02_rows_identical": bool(len(s2a) == len(s2b) and all((s2a[c].astype(str).values == s2b[c].astype(str).values).all() for c in s2a.columns)),
                   "fold_persons_identical": fa == fb,
                   "fold_persons_sha256": {"frozen": sha(F / "fold_persons.json"), "rebuilt": sha(R / "fold_persons.json")}}
    REP["status"] = "PASS" if all(v for k, v in REP["hard"].items() if k != "fold_persons_sha256") else "FAIL"
    if partial and REP["status"] == "FAIL":
        REP["status"] = "PARTIAL (smoke rebuild with fewer folds: hard checks reported, not enforced)"
(OUT / "safe04_compare.json").write_text(json.dumps(REP, indent=1))
lines = [f"safe04_compare: {REP['status']}"] + [f"  {k}: {v}" for k, v in REP["hard"].items()]
for name, t in REP["tables"].items():
    num = {c: v for c, v in t["columns"].items() if isinstance(v, dict)}
    worst = max(num.items(), key=lambda kv: kv[1]["max_abs_diff"] or 0) if num else None
    if t.get("missing"):
        lines.append(f"  {name}: {t['missing']}"); continue
    lines.append(f"  {name}: rows {t['rows']} sha256_equal {t['sha256_equal']} | different keys {[c for c, v in t['columns'].items() if v == 'DIFFERENT']} | "
                 f"largest numeric diff {worst[0] + ' ' + str(worst[1]) if worst else '-'}")
(OUT / "safe04_compare.txt").write_text("\n".join(lines) + "\n")
print("\n".join(lines), flush=True)
assert REP["status"] != "FAIL", "safe04_compare: a hard check failed (see safe04_compare.txt)"
# <<<FF-CELL>>>
